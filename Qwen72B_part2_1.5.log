        T(fig,x+.012,y1-.105,wrap(s["title"],52,4),size=9.2,weight="bold",color=INK,va="center",linespacing=1.2,xmax=x+w-.008)
        rows=[("PMCID",s["pmcid"]),("Licence","CC BY 4.0 · "+s["license"].replace("https://","")),("Retrieved","Europe PMC full-text XML (730.py)"),("Published",s["published"]),
              ("Excerpt",f"{s['excerpt_chars']:,} characters (sealed_sources/{cid}.txt)"),("Excerpt SHA-256",s["excerpt_sha256"][:32]),("",s["excerpt_sha256"][32:]),
              ("Body tokens",f"{REC['body_tokens'][cid]:,} (Qwen2.5 tokenizer)"),("Cartridge commit",REC["commits"][cid]["sha256"][:32]),("",REC["commits"][cid]["sha256"][32:])]
        for j,(a,b) in enumerate(rows):
            yy=y1-.205-j*.034
