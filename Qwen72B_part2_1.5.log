                                         size=8.2,weight="bold",color=OK_COL if ok else RED,xmax=x+w-.008)
            at=L.get("attribution") or {};au=at.get("authors") or []
            T(fig,x+.012,yy,("Authors: "+(", ".join(au[:3])+(" et al." if len(au)>3 else "")) if au else "Authors: see article")+(f" · {at.get('journal')}" if at.get("journal") else ""),size=7.5,color=INK2,xmax=x+w-.008)
            if at.get("doi"):T(fig,x+.012,yy-.026,"DOI "+at["doi"],size=7.5,color=INK2,mono=True,xmax=x+w-.008)
