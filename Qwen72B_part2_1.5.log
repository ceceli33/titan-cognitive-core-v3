# ---------------------------------------------------------------------------------------------------------------------
# Figs. 5 and 6 — read-only X-ray of the real K/V tensors
# ---------------------------------------------------------------------------------------------------------------------
def _xr(cid):
    m=(LIVE.get("xray") or {}).get(cid)
    if not m or not Path(m["file"]).is_file():return None
    if not SIM and m.get("provenance")!="GPU_REAL":return None
    z=np.load(m["file"]);return z["K"],z["V"],m
def binned(a,b=XRAY_BIN):
    nb=int(np.ceil(a.shape[1]/b));return np.stack([a[:,i*b:(i+1)*b].mean(axis=1) for i in range(nb)],axis=1)
def zlayer(a):
    mu=a.mean(axis=1,keepdims=True);sd=a.std(axis=1,keepdims=True);sd[sd==0]=1;return np.clip((a-mu)/sd,-3,3)
def _heat(ax,arr,P,title,col,show_y=True):
    b=zlayer(binned(arr));im=ax.imshow(b,aspect="auto",origin="lower",cmap="RdBu_r",vmin=-3,vmax=3,interpolation="nearest",extent=[0,b.shape[1]*XRAY_BIN,-.5,79.5])
    ax.set_xlim(0,arr.shape[1])
    ax.axhline(3.5,color="#111827",lw=1.1,ls="--");ax.axvline(P,color="#111827",lw=.8,ls=":")
    ax.set_title(title,fontsize=9.5,color=col);ax.set_yticks([0,20,40,60,79] if show_y else []);ax.tick_params(labelsize=7.5)
    if show_y:ax.text(-.012,3.5,"CUT3",transform=ax.get_yaxis_transform(),ha="right",va="center",fontsize=7,color="#111827",weight="bold")
    ax.set_xticks([x for x in (0,500,1000,1500,2000,2500) if x<arr.shape[1]])
    return im
def fig5():
    k="F5";D={c:_xr(c) for c in SRC_IDS}
    if not all(D.values()):return fig_missing(k,"SOURCE_MEMORY_XRAY","K and V norm heat maps of P01, P02 and P03 (layers 0–79) need the live read-only X-ray of the real GPU tensors (stage 7 of RUN).",
                                           "Not available in this session: "+", ".join(c for c,v in D.items() if not v)+". TEST730.log contains no X-ray tensors; no heat map is drawn without a measurement.")
    fig=fig_base(k,"Real K/V tensors of each source cartridge, mounted ALONE with initialize_native (three separate GPU states, not one simultaneous memory) · read-only","LIVE GPU MEASUREMENT")
    xs=[.065,.36,.655];W=.255
    for i,cid in enumerate(SRC_IDS):
        K,V,m=D[cid]
        for r,(arr,nm) in enumerate(((K,"‖K‖"),(V,"‖V‖"))):
            ax=fig.add_axes([xs[i],.525-r*.37,W,.275]);im=_heat(ax,arr,m["prefix_tokens"],f"{cid} · {nm} · {arr.shape[1]:,} memory rows",COL[cid],show_y=(i==0))
            if i==0:ax.set_ylabel("transformer layer",fontsize=9)
            if r==1:ax.set_xlabel("memory row (token position)",fontsize=8.5)
    cb=fig.colorbar(im,cax=fig.add_axes([.925,.155,.009,.645]));cb.set_label("per-layer z-score (clipped ±3)",fontsize=8.5);cb.ax.tick_params(labelsize=7.5)
    T(fig,.065,.858,"dashed line = CUT3 boundary (L0–L3 stored in the cartridge · L4–L79 rebuilt) · dotted line = end of the PREFIX rows",size=8.6,color=INK2,xmax=.92)
    fig_footer(fig,k,f"‖K‖,‖V‖: L2 norm over head_dim (128), mean of the 8 KV heads, per row; mean over bins of {XRAY_BIN} rows; colour = z-score within each layer of each cartridge. Raw values: measurements/xray/*.npz, XRAY_SUMMARY.json.")
    return save_fig(fig,k,"SOURCE_MEMORY_XRAY","LIVE GPU MEASUREMENT",["measurements/xray/XRAY_P01.npz","XRAY_P02.npz","XRAY_P03.npz","XRAY_SUMMARY.json"])
