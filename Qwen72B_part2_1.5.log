def answer_status(qid):
    q=REC["questions"][qid];n=(LIVE.get("recorded_answer_tokens") or {}).get(qid)
    if n is not None:
        if n>=E["MAX_NEW"]-8:return f"response generated · reached the 768-token limit (re-tokenized {n})"
        if not q["ends_cleanly"]:return f"response generated · ends mid-sentence, consistent with the 768-token limit (re-tokenized {n})"
        return f"response generated · ended before the limit (re-tokenized {n})"
    return "response generated · "+("ends mid-sentence: consistent with the 768-token limit" if not q["ends_cleanly"] else "ends with complete sentence")
def fig9():
    k="F9";fig=fig_base(k,"Six questions sealed by SHA-256 before any source or model was accessed · asked to the MASTER memory alone · answers as recorded in 730.log","VERIFICATION RECORD")
    xs=[.035,.085,.385,.80,.86];hd=["ID","question (sealed panel)","MASTER answer — opening excerpt (verbatim)","time","status"]
