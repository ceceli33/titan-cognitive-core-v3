# ---------------------------------------------------------------------------------------------------------------------
# markdown structure of the recorded model texts (quotes are cut, never reworded)
# ---------------------------------------------------------------------------------------------------------------------
def unmd(s):return re.sub(r"\s+"," ",re.sub(r"\*\*|__|`","",str(s))).strip(" -")
def md_blocks(text):
    out=OrderedDict();cur="_top";out[cur]=[]
    for ln in str(text).split("\n"):
        m=re.match(r"^\s*#{2,6}\s+(.*)$",ln)
        if m:cur=unmd(m.group(1)).rstrip(":");out.setdefault(cur,[]);continue
        out[cur].append(ln)
    return out
def md_items(lines):
    items=[]
    for ln in lines:
        m=re.match(r"^\s*(\d+)\.\s+\*\*(.+?)\*\*\s*:?\s*(.*)$",ln)
        b=re.match(r"^\s*-\s+\*\*(.+?)\*\*\s*:?\s*(.*)$",ln)
        if m:items.append(dict(head=unmd(m.group(2)).rstrip(":"),text=unmd(m.group(3)),sub=[]))
        elif b and items:items[-1]["sub"].append((unmd(b.group(1)).rstrip(":"),unmd(b.group(2)),unmd(ln)))
        elif b:items.append(dict(head=unmd(b.group(1)).rstrip(":"),text=unmd(b.group(2)),sub=[],full=unmd(ln)))
        elif items and ln.strip():items[-1]["sub"].append(("",unmd(ln),unmd(ln)))
    for it in items:
        blob=it["head"]+" "+it["text"]+" "+" ".join(f for a,b,f in it["sub"])
        it["refs"]=sorted(set(re.findall(r"\bP0[123]\b",blob)))
        it["first"]=it["text"] or next((f for a,b,f in it["sub"] if f),"")
    return items
def block(text,name):
    bl=md_blocks(text);n=name.lower()
    for k,v in bl.items():
        if k.lower()==n:return v
    return next((v for k,v in bl.items() if k.lower().startswith(n) and any(x.strip() for x in v)),[])
def first_par(lines):
    s=" ".join(x.strip() for x in lines if x.strip() and not x.strip().startswith(("-","1.")))
    return unmd(s)

