    hline(fig,.035,.965,.845,NEU)
    for i,(qid,q) in enumerate(REC["questions"].items()):
        y=.80-i*.103;lvl="HUMAN" if qid.startswith("H") else "ADVANCED"
        rect(fig,.035,y-.072,.93,.094,PANEL if i%2==0 else "white",z=0)
        T(fig,.04,y-.005,qid,size=13,weight="bold",color=COL["MASTER"]);T(fig,.04,y-.04,lvl.lower(),size=7,color=MUTED)
        T(fig,.085,y+.012,wrap(q["question"],62,3),size=7.8,va="top",linespacing=1.15,xmax=.378)
        ex=unmd(re.sub(r"#+\s*","",q["answer"]))
        T(fig,.385,y+.012,"“"+wrap(ex,92,3)+"”",size=7.5,va="top",color=INK2,linespacing=1.15,xmax=.795)
