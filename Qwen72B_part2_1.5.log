        for s in ("top","right"):ax.spines[s].set_visible(False)
    axv.set_xlabel("transformer layer",fontsize=8.5);axk.legend(fontsize=7.4,loc="upper left",ncol=1)
    src=[c for c in SRC_IDS if D[c]]
