    if not rp and not nq:return fig_missing(k,"LIVE_MASTER_QUERIES","Live answers of the MASTER memory (reproduction of H1 and A1; two new questions with and without memory) need RUN on an A100 80 GB GPU.",
                                            "No live answer exists in this session. Recorded answers are never shown as live answers.")
    fig=fig_base(k,"Answers generated NOW on the MASTER memory by the unchanged engine · reproduction of two sealed questions · two new questions (not sealed) with and without memory","LIVE GPU MEASUREMENT")
    T(fig,.035,.855,"Reproduction of sealed questions (the recorded answers remain the official TEST730 answers)",size=10.5,weight="bold")
    for i,(qid,r) in enumerate(rp.items()):
        y=.80-i*.075;ok=r["identical_to_record"];box(fig,.035,y-.03,.93,.065,ec=OK_COL if ok else AMBER,lw=1.2)
        T(fig,.045,y,qid,size=13,weight="bold",color=COL["MASTER"])
        T(fig,.09,y+.012,("BYTE-IDENTICAL to the TEST730 record" if ok else f"differs from the record after {r['common_prefix_chars']:,} identical characters"),size=9.5,weight="bold",color=OK_COL if ok else AMBER,xmax=.6)
        T(fig,.09,y-.014,f"record {k_sha(r['recorded_sha256'],16)} · now {k_sha(r['sha256'],16)}",size=7.8,mono=True,color=INK2,xmax=.6)
        T(fig,.62,y,f"{r['n_generated']} tokens · {r['seconds']:.1f} s · {r['tokens_per_second']} tok/s · record {r['recorded_seconds']} s",size=8.4,color=INK,xmax=.96)
    y0=.80-len(rp)*.075-.03
    T(fig,.035,y0,"New questions written for this demonstration (published in the code before the run; NOT part of the sealed panel)",size=10.5,weight="bold")
    for i,(qid,v) in enumerate(nq.items()):
        y=y0-.05-i*.215;T(fig,.035,y,f"{qid} · "+v["question"],size=8.6,weight="bold",xmax=.965)
        for j,(lab,r,col) in enumerate((("MASTER memory",v["master"],COL["MASTER"]),("no memory",v["no_memory"],NEU))):
            x=.035+j*.47;box(fig,x,y-.19,.455,.165,ec=col,lw=1.2)
            mk=r["markers"];T(fig,x+.01,y-.045,f"{lab} · {r['n_generated']} tok · {r['seconds']:.1f} s",size=8.4,weight="bold",color=col,xmax=x+.25)
            T(fig,x+.445,y-.045,"keywords: "+" ".join(("✓" if hit else "✗")+m for m,hit in mk.items()),size=7.6,color=INK2,ha="right",xmax=x+.452)
            T(fig,x+.01,y-.065,"“"+wrap(unmd(r["answer"]),98,4)+"”",size=7.5,color=INK,va="top",linespacing=1.15,xmax=x+.45)
    fig_footer(fig,k,"BYTE-IDENTICAL = reproducibility of the recorded output, not proof of semantic correctness. Keyword check = observational, not a grade. Greedy, MAX_NEW 768, unchanged answer(); no-memory = answer(None, q).")
    return save_fig(fig,k,"LIVE_MASTER_QUERIES","LIVE GPU MEASUREMENT",["LIVE_MEASUREMENTS.json repro, newq","LIVE_QUERY_ANSWERS.jsonl"])

FIG_FUNCS=OrderedDict([("F1",fig1),("F2",fig2),("F3",fig3),("F4",fig4),("F5",fig5),("F6",fig6),("F7",fig7),("F8",fig8),("F9",fig9),("F10",fig10),("F11",fig11),("F12",fig12),("S1",figS1)])
def render_figures():
    errs={}
    for key,fn in FIG_FUNCS.items():
        t=time.perf_counter()
        try:
            rec=fn();FIG_FILES[key]=rec;STATE["fig_version"]+=1;bump()
            _emit(f"  figure {FIGURES[key]['n']} · {rec['badge']} · {rec['pixels'][0]}×{rec['pixels'][1]} · layout QC {'pass' if rec['layout_qc']['passed'] else 'WARN'} · {time.perf_counter()-t:.1f} s")
        except Exception as ex:
            errs[key]=f"{type(ex).__name__}: {ex}";FIG_FILES.pop(key,None);flog_fig(f"{key} NOT GENERATED {traceback.format_exc()[-1500:]}");_emit(f"  figure {key} NOT GENERATED · {errs[key]}")
            plt.close("all")
    FIG_ERRORS.clear();FIG_ERRORS.update(errs)
    dump_json(SESSION_DIR/"FIGURES_MANIFEST.json",dict(session=SESSION_ID,utc=utc_now(),simulation=SIM,figures=FIG_FILES,not_generated=errs))
    return errs

# ---------------------------------------------------------------------------------------------------------------------
# measurements, provenance table, run summary, SHA-256 manifest (no ZIP)
