    for L in (0,20,40,60,79):T(fig,x0+L*w+w/2,.565,f"L{L}",size=7.5,ha="center",color=MUTED)
    T(fig,x0+4*w-.003,.565,"L3",size=7.5,ha="right",color=MUTED);T(fig,x0+4*w+.003,.565,"L4 →",size=7.5,ha="left",color=MUTED)
    T(fig,x0+4*w+.004,.665,"CUT3 boundary — H3 = output of layer 3 (stored; injected here at mount time)",size=8.8,weight="bold",color=COL["MASTER"])
    T(fig,x0,.665,"L0–L3",size=8.8,weight="bold",color=LOWER_COL)
    T(fig,.06,.535,"stored in the cartridge: K/V of L0–L3 + H3",size=8.6,color=LOWER_COL,weight="bold")
    T(fig,.50,.535,"NOT stored: L4–L79 K/V are rebuilt by the frozen model's natural forward computation (initialize_native)",size=8.6,color=INK2,xmax=.965)
    hdr=["cartridge","rows n = P + body","H3 tensor","H3 bytes","L0–L3 K, V tensors (×4 layers)","L0–L3 bytes","file on SSD","full 80-layer K/V","stored/full"]
    xs=[.035,.105,.215,.335,.425,.62,.70,.785,.905];y=.475
    T(fig,.035,.495,"Measured from the cartridge files in this session (shapes and bytes read with torch.load; no value carried over from TEST709)",size=9,weight="bold",color=INK)
    for x,h in zip(xs,hdr):T(fig,x,y-.025,h,size=7.8,weight="bold",color=MUTED)
    hline(fig,.035,.965,y-.04,RULE)
    for j,cid in enumerate(CARTS):
        yy=y-.075-j*.072;a=ART.get(cid) or {};f=a.get("facts")
        T(fig,.035,yy,cid,size=9.5,weight="bold",color=COL[cid])
        if not f:T(fig,.105,yy,"cartridge file not present in this runtime — not measured"+(" (press RUN on an A100 to recover it from its sealed text)" if a.get("status")=="MISSING" else ""),size=8.4,color=RED);continue
        vals=[f"{f['n']:,} = {f['p']} + {f['body_tokens']:,}",f"{tuple(f['h_shape'])} {f['h_dtype'].replace('torch.','')}",fmt_b(f["h_bytes"]),f"K {tuple(f['k_shape'])} · V {tuple(f['v_shape'])}",
              fmt_b(f["lower_bytes"]),fmt_b(a.get("bytes")),fmt_b(f["full_80_layer_kv_bytes"]),f"{(f['h_bytes']+f['lower_bytes'])/f['full_80_layer_kv_bytes']*100:.1f} %"]
        for x,v,nx in zip(xs[1:],vals,xs[2:]+[.965]):T(fig,x,yy,v,size=8.0,color=INK,mono=True,xmax=nx-.006)
    fig_footer(fig,k,"Full 80-layer K/V = n × 80 layers × 8 KV heads × 128 × 2 (K,V) × 2 bytes (BF16) = n × 327,680 bytes. The cartridge keeps H3 + L0–L3 only; the remainder is recomputed from H3 at mount time.")
    return save_fig(fig,k,"CUT3_INJECTION_PROTOCOL","SCHEMATIC",["730.py (native CUT3 functions, locked)","cartridge files P01/P02/P03/MASTER.pt (torch.load, this session)","LIVE_MEASUREMENTS.json cartridges.facts"])

