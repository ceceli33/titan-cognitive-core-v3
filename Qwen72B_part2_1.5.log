    hline(fig,.035,.965,.165,NEU)
    T(fig,.035,.14,f"Presealed question panel SHA-256  {REC['panel_sha256']}",size=8.6,mono=True,color=INK,xmax=.6)
    T(fig,.62,.14,"6/6 responses generated",size=11.5,weight="bold",color=OK_COL);T(fig,.62,.105,"Independent correctness: NOT YET GRADED",size=11.5,weight="bold",color=AMBER,xmax=.965)
    re_ok=ENGINE_INFO.get("panel_rederived_sha256")==REC["panel_sha256"]
    T(fig,.035,.105,("✓ panel SHA-256 re-derived in this session from the QUESTION_SET of the locked 730.py" if re_ok else "✗ panel SHA-256 could not be re-derived"),size=8.2,color=OK_COL if re_ok else RED)
    fig_footer(fig,k,"Answers were generated greedily on the MASTER memory with MAX_NEW = 768; full texts in the SIX-QUESTION DEMO tab and RUN_SUMMARY.txt. No grading was performed by TEST730 or by this demo.")
    return save_fig(fig,k,"SIX_PRESEALED_QUESTIONS","VERIFICATION RECORD",["730.log QUESTION_PANEL_PRESEALED_SHA256, DEMO_QUESTION/ANSWER/SECONDS","730.py QUESTION_SET (re-derived panel SHA)"])

