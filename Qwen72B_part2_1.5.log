# Fig. 10 — advanced reasoning
# ---------------------------------------------------------------------------------------------------------------------
def fig10():
    k="F10";Q=REC["questions"]
    fig=fig_base(k,"Model-generated proposals from the MASTER memory (A1–A3, recorded) · shown as hypotheses, NOT as results established by P01–P03 · not independently validated","OBSERVATIONAL")
    rect(fig,.035,.835,.93,.035,"#FEF3C7",z=0);T(fig,.045,.852,"MODEL-GENERATED HYPOTHESES — distinct from the source evidence; source IDs show which article each element cites",size=9,weight="bold",color=AMBER)
    W=.297;xs=[.035,.3515,.668]
    heads=[("A1 · Causal model",Q["A1"]["question"]),("A2 · Falsification experiment",Q["A2"]["question"]),("A3 · Rival explanations + decisive test",Q["A3"]["question"])]
    for x,(h,qq) in zip(xs,heads):
        box(fig,x,.10,W,.715,ec=COL["MASTER"],lw=1.3);T(fig,x+.01,.795,h,size=10.5,weight="bold",color=COL["MASTER"],xmax=x+W-.006)
        T(fig,x+.01,.77,wrap(qq,70,2),size=7.0,color=MUTED,va="top",style="italic",linespacing=1.1,xmax=x+W-.006)
    def lines(x,y,rows,width=60,ymin=.115):
        for kind,txt,col in rows:
            if y<ymin+.03:break
            if kind=="h":t=T(fig,x+.01,y,txt,size=9.2,weight="bold",color=col or INK,va="top",xmax=x+W-.006)
            else:t=T(fig,x+.016,y,wrap(txt,width,3),size=8.0,color=col or INK2,va="top",linespacing=1.13,xmax=x+W-.006)
            b=_bb(fig,t);y=b.y0-(.010 if kind=="h" else .016)
        return y
    a1=md_items(block(Q["A1"]["answer"],"Causal Model"));pr=md_items(block(Q["A1"]["answer"],"Predictions"))
    def _assume(it):
        x_=next((bb for aa,bb,ff in it["sub"] if aa.lower().startswith("assumption")),"")
        return f"{it['head']}  [{', '.join(it['refs']) or '—'}]"+(f" — assumption: {x_}" if x_ else "")
    r=[("h","Model components (sources cited)",None)]+[("t",f"{i+1}. "+_assume(it),INK) for i,it in enumerate(a1[:5])]
    r+=[("h","Predictions stated by the model",None)]+[("t","• "+it["head"]+(": "+it["first"] if it["first"] else ""),None) for it in pr[:2]]
    lines(xs[0],.725,r)
    iv=md_items(block(Q["A2"]["answer"],"Interventions"));ms=md_items(block(Q["A2"]["answer"],"Measures"));cf=md_items(block(Q["A2"]["answer"],"Confounders"))
    pt=md_items(block(Q["A2"]["answer"],"Participants"))
    r=[("h","Randomized arms",None)]+[("t",f"{it['head']}: {it['first']}",None) for it in iv[:3]]
    r+=[("h","Measures",None)]+[("t","• "+it["head"]+(" — "+"; ".join(a for a,b,f in it["sub"][:2] if a) if it["sub"] else ""),None) for it in ms[:4]]
    r+=[("h","Confounders · sample",None),("t",", ".join(it["head"] for it in cf[:4])+("" if not pt else " · "+"; ".join(f"{it['head']}: {it['first']}" for it in pt[:1])),None)]
    lines(xs[1],.725,r)
    rv=md_items(block(Q["A3"]["answer"],"Rival Explanations"));td=md_items(block(Q["A3"]["answer"],"Smallest Decisive Test"))
    con=[ln for ln in block(Q["A3"]["answer"],"Most Consequential") if ln.strip()]
    r=[("h","Contradiction named by the model",None),("t",unmd(con[0]) if con else "—",INK)]
    for it in rv[:2]:
        hyp=next((b for a,b,f in it["sub"] if a.lower().startswith("hypothesis")),it["first"])
        r+=[("h",it["head"],COL["MASTER"]),("t",hyp,None)]
    grp=[it for it in td if it["head"].lower().startswith("group")] or td
    res=[it for it in td if it["head"].lower().startswith("if ")]
    r+=[("h","Smallest decisive test (model proposal)",None)]+[("t",f"{it['head']}: {it['first']}",None) for it in grp[:2]]
    r+=[("h","What each result would imply (model)",None)]+[("t",f"{it['head']} → {it['first']}",None) for it in res[:2]]
    refs=sorted(set(re.findall(r"\bP0[123]\b",Q["A3"]["answer"])))
    yend=lines(xs[2],.725,r);T(fig,xs[2]+.01,max(.115,yend-.008),f"sources cited in A3: {', '.join(refs) or '—'}",size=7.8,color=MUTED,va="top")
    fig_footer(fig,k,"Item headings and sentences are extracted from the recorded answers (markdown structure), shortened with “…”. A1–A3 answers end at the 768-token limit. Novelty and validity are not assessed.")
    return save_fig(fig,k,"STORED_SYNTHESIS_TO_HYPOTHESES","OBSERVATIONAL",["730.log DEMO_ANSWER A1, A2, A3"])

