def fig3():
    k="F3";fig=fig_base(k,"Native CUT3 path of 730.py: the cartridge stores the layer-3 output H3 and the K/V of layers 0–3; layers 4–79 are recomputed when the cartridge is mounted","SCHEMATIC")
    steps=[("1  READ","source text → tokens\n(PREFIX + body)"),("2  FORGE","forward pass L0–L79\nH3 captured at CUT3\n(direct forward, no hook)"),
           ("3  PERSIST","torch.save → SSD\nSHA-256 of file\nand of the tensors"),("4  INJECT + REBUILD","zero inputs · H3 placed at\nlayer-3 output · L4–L79\nrecomputed naturally"),
           ("5  ANSWER","question appended to the\n80-layer K/V memory\ngreedy decoding")]
    for i,(h,t) in enumerate(steps):
        x=.035+i*.188;box(fig,x,.70,.172,.16,ec=NEU,fc=PANEL,lw=1.2)
        T(fig,x+.012,.835,h,size=10.5,weight="bold",xmax=x+.168);T(fig,x+.012,.765,t,size=8.4,color=INK2,linespacing=1.25,xmax=x+.168)
        if i<4:arrow(fig,x+.173,.78,x+.187,.78,col=NEU,lw=1.4,ms=11)
