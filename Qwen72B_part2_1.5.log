RUN_SUMMARY=SESSION_DIR/"RUN_SUMMARY.txt";MANIFEST=SESSION_DIR/"SHA256_MANIFEST.json";ZIP_PATH=SESSION_DIR/f"{SESSION_ID}_AKBASCORE_PROMETHEUS_TEST730_DEMO.zip"
def write_measurements():
    dump_json(LIVE_FILE,{k:v for k,v in LIVE.items() if not k.startswith("_")})
    dump_json(CHECK_FILE,dict(session=SESSION_ID,utc=utc_now(),simulation=SIM,live_checks=LIVE_CHECKS,recorded_checks=REC.get("checks"),
                              passed=sum(c["passed"] for c in LIVE_CHECKS),total=len(LIVE_CHECKS)))
    dump_json(DATA_DIR/"CARTRIDGES.json",dict(test730_directory=ORIG.get("root"),cartridges=ART,manifest_checks=ORIG.get("manifest_checks"),results_checks=ORIG.get("results_checks"),
                                               sealed_sources=ORIG.get("sealed_sources")))
    dump_json(DATA_DIR/"STAGES.json",dict(verdict=run_verdict(),state={k:v for k,v in STATE.items() if k not in("master_memory","master_gpu_cp","master_seals_before")},stages=STAGES))
    rows=[]
    for key,meta in FIGURES.items():
        p=PROVENANCE.get(key) or {};f=FIG_FILES.get(key) or {}
        rows.append(dict(figure=meta["n"],key=key,title=meta["title"],tab=meta["tab"],badge=p.get("badge") or "not generated",data_sources=" | ".join(p.get("data_sources") or []),
                         jpg=Path(f["jpg"]).name if f.get("jpg") else "",sha256_jpg=f.get("sha256_jpg",""),layout_qc=(f.get("layout_qc") or {}).get("passed"),simulation=SIM))
    with (SESSION_DIR/"PROVENANCE_TABLE.csv").open("w",newline="",encoding="utf-8") as fh:
        w=csv.DictWriter(fh,fieldnames=list(rows[0]));w.writeheader();w.writerows(rows)
    dump_json(SESSION_DIR/"PROVENANCE_TABLE.json",rows)
def write_run_summary():
    L=[];a=L.append;fp=LIVE.get("master_fast_path") or {}
    a(f"{APP_NAME} — {APP_SUB}\n{EXPERIMENT} live demonstration · code {CODE_VERSION} · session {SESSION_ID} · written {local_now()}")
    if SIM:a("SIMULATION STACK — NOTHING IN THIS FILE IS AN EXPERIMENTAL RESULT")
    a(f"MODE {STATE['mode']} · RUN started {STATE.get('started')} · finished {STATE.get('finished')}\nRUN VERDICT {run_verdict()}")
    a("\nSTAGES OF THIS RUN")
    for key,title in STAGES.items():
        s=STATE["stages"][key];a(f"  [{s['status'].upper():<4}] {key:<10} {('%.1f s'%s['seconds']) if s['seconds'] is not None else '':>9}  {title}\n             {s['note']}")
    a(f"\nRECORDED TEST730 (730.log git blob {LOCKS['730.log']}) — documentation, not re-run")
    a(f"  result {REC['result']} · {REC['checks_passed']}/{REC['checks_total']} logged checks PASS · panel SHA-256 {REC['panel_sha256']}")
    for k in SRC_IDS:
        s=REC["sources"][k];a(f"  {k} {s['pmcid']} · {s['title']}\n      licence {s['license']} · excerpt SHA-256 {s['excerpt_sha256']} · {REC['body_tokens'][k]} tokens · cartridge {REC['commits'][k]['sha256']}")
    a(f"  MASTER {REC['body_tokens']['MASTER']} tokens · commit SHA-256 {REC['commits']['MASTER']['sha256']}")
    a("  6/6 responses generated · independent correctness: NOT YET GRADED")
    for qid,q in REC["questions"].items():a(f"\n  {qid} ({q['seconds']} s) {q['question']}\n  --- recorded answer (verbatim, {answer_status(qid)}) ---\n  "+q["answer"].replace("\n","\n  "))
    a("\nCARTRIDGES IN THIS SESSION")
    for c in CARTS:
        x=ART.get(c) or {};a(f"  {c}: {x.get('status')} · {x.get('origin')} · file {x.get('path')} · sha256 now {x.get('sha256_now')} · equal to record {x.get('equal_record')}")
    if fp:a(f"\nMASTER FAST PATH (live) {json.dumps(jsafe(fp),ensure_ascii=False)}")
    if LIVE.get("parity"):a(f"PARITY (live) {LIVE['parity']['matched']}/{LIVE['parity']['layers']}")
    for qid,r in (LIVE.get("repro") or {}).items():a(f"\nREPRODUCTION {qid} identical to record: {r['identical_to_record']} · {r['n_generated']} tokens · {r['seconds']} s\n  "+r["answer"].replace("\n","\n  "))
    for qid,v in (LIVE.get("newq") or {}).items():
        a(f"\nNEW QUESTION {qid} (not sealed) {v['question']}")
        for lab in ("master","no_memory"):r=v[lab];a(f"  [{lab}] {r['n_generated']} tok · {r['seconds']} s · keywords {r['markers']}\n  "+r["answer"].replace("\n","\n  "))
    for r in LIVE.get("user_queries") or []:a(f"\nLIVE QUERY (user, not sealed) {r['question']}\n  {r['n_generated']} tok · {r['seconds']} s\n  "+r["answer"].replace("\n","\n  "))
    a(f"\nLIVE CHECKS {sum(c['passed'] for c in LIVE_CHECKS)}/{len(LIVE_CHECKS)} PASS")
    for c in LIVE_CHECKS:a(f"  {'PASS' if c['passed'] else 'FAIL'} {c['name']} {c['detail'] if c['detail'] is not None else ''}")
    a("\nSCOPE  The completed TEST730 run is documented, not repeated. Reading and synthesis used general programmed prompts (no zero-prompt autonomy claim). "
      "The six answers are not graded; no superhuman claim. New questions are not part of the sealed panel.")
    a(f"{AUTHOR} · {ORG} · {LICENSE_NAME} · {COPYRIGHT} · articles CC BY 4.0 © their authors")
    RUN_SUMMARY.write_text("\n".join(L)+"\n",encoding="utf-8")
def _category(rel):
    if rel.startswith("figures"):return "figure"
    if rel.startswith("measurements"):return "measurement (this session)"
    if rel.startswith("test730_record"):return "TEST730 record (locked, documentation)"
    if rel.startswith("locked_sources"):return "locked source"
    if rel.startswith("recovery"):return "recovery manifest"
    return "session record"
def package_session():
    write_measurements();write_run_summary()
    files=[(p,str(p.relative_to(SESSION_DIR))) for p in sorted(SESSION_DIR.rglob("*")) if p.is_file() and p.suffix not in(".zip",".tmp",".pt") and p!=MANIFEST]
    files+=[(EVID_DIR/n,f"locked_sources/{n}") for n in LOCKS if (EVID_DIR/n).is_file()]
    if (RECOVERY_DIR/"RECOVERY_manifest.json").is_file():files.append((RECOVERY_DIR/"RECOVERY_manifest.json","recovery/RECOVERY_manifest.json"))
    man=OrderedDict((arc,dict(sha256=sha_file(p),bytes=p.stat().st_size,category=_category(arc))) for p,arc in files)
    man["cartridge files (not packaged — hashes only)"]={c:dict(path=(ART.get(c) or {}).get("path"),sha256=(ART.get(c) or {}).get("sha256_now"),record=REC["commits"][c]["sha256"]) for c in CARTS}
    dump_json(MANIFEST,dict(session=SESSION_ID,utc=utc_now(),simulation=SIM,note="SHA-256 of every file of this RUN (no ZIP is made; each file is downloaded directly). Cartridge tensors (.pt) are listed by hash only.",files=man))
    return str(MANIFEST)
def download_items():
    items=[("Run summary",RUN_SUMMARY),("Live measurements",LIVE_FILE),("Verification record",CHECK_FILE),("Provenance table (CSV)",SESSION_DIR/"PROVENANCE_TABLE.csv"),
           ("SHA-256 manifest",MANIFEST),("Session log",SESSION_LOG),("Engine log",ENGINE_LOG),("Cartridge record",DATA_DIR/"CARTRIDGES.json"),("X-ray summary",DATA_DIR/"XRAY_SUMMARY.json"),
           ("Session events, timestamped (JSONL)",SESSION_EVENTS),("Stage record",DATA_DIR/"STAGES.json"),("Figure generation log",SESSION_DIR/"FIGURE_GENERATION.log"),
           ("Figure manifest",SESSION_DIR/"FIGURES_MANIFEST.json"),("Live query answers",LIVE_QA),("Parsed TEST730 record (RECORD, not this session)",REC_DIR/"TEST730_RECORD_PARSED.json"),
           ("TEST730 log (RECORD, locked)",REC_DIR/"730.log")]
    return [(l,str(p)) for l,p in items if Path(p).is_file()]

# ---------------------------------------------------------------------------------------------------------------------
# THE RUN PIPELINE (one button) — every stage reported; failures are recorded and never shown as success
# ---------------------------------------------------------------------------------------------------------------------
def stage_figures():
    if E.get("tok") is not None and "recorded_answer_tokens" not in LIVE:
        LIVE["recorded_answer_tokens"]={qid:len(E["tok"](q["answer"],add_special_tokens=False).input_ids) for qid,q in REC["questions"].items()}
        LIVE["recorded_synthesis_tokens"]=len(E["tok"](REC["synthesis"],add_special_tokens=False).input_ids)
    errs=render_figures();n=len(FIG_FILES)
    qcf=[k for k,v in FIG_FILES.items() if not (v.get("layout_qc") or {}).get("passed") or not (v.get("jpeg_qc") or {}).get("passed")]
    note=f"{n}/{len(FIGURES)} JPEG figures written (300 dpi)"
    if errs or qcf:raise RuntimeError(note+(f" · NOT GENERATED: {errs}" if errs else "")+(f" · LAYOUT/JPEG QC FAILED: {', '.join(qcf)} (shown, marked QC FAIL)" if qcf else ""))
    return note+" · layout QC and JPEG QC passed for every figure"
def stage_package():
    package_session();n=len(download_items())
    return f"{len(FIG_FILES)} JPEG figures + {n} records/logs, each downloadable directly · SHA-256 manifest {MANIFEST.name} (no ZIP)"
STAGE_FUNCS=OrderedDict([("SOURCES",stage_sources),("GPU",stage_gpu),("MODEL",stage_model),("CARTRIDGES",stage_cartridges),("MASTER",stage_master),("PARITY",stage_parity),
                         ("XRAY",stage_xray),("REPRO",stage_repro),("NEWQ",stage_newq),("INTEGRITY",stage_integrity),("FIGURES",stage_figures),("PACKAGE",stage_package)])
NEEDS=dict(MASTER=("MODEL","CARTRIDGES"),PARITY=("MASTER",),XRAY=("MODEL","CARTRIDGES"),REPRO=("MASTER",),NEWQ=("MASTER",),INTEGRITY=("MODEL",))
def _is_oom(ex):return "OutOfMemoryError" in type(ex).__name__ or "out of memory" in str(ex).lower() or "GPU_SAFETY_STOP" in str(ex)
RUNS_DONE=[]
def _new_run_dir():
    """every RUN after the first one writes into its OWN folder (figures, measurements, logs); nothing of an earlier RUN
    (live results, figures, measurements, checks, mounted memory) is carried into the new one"""
    global SESSION_ID,SESSION_DIR,FIG_DIR,DATA_DIR,REC_DIR,XRAY_DIR,SESSION_LOG,SESSION_EVENTS,ENGINE_LOG,LIVE_QA,LIVE_FILE,CHECK_FILE,RUN_SUMMARY,MANIFEST,ZIP_PATH
    if RUNS_DONE:
        SESSION_ID=datetime.now().astimezone().strftime("P730-%Y%m%d-%H%M%S")+f"-RUN{len(RUNS_DONE)+1}"
        SESSION_DIR=DEMO_ROOT/"sessions"/SESSION_ID;FIG_DIR=SESSION_DIR/"figures";DATA_DIR=SESSION_DIR/"measurements";REC_DIR=SESSION_DIR/"test730_record";XRAY_DIR=DATA_DIR/"xray"
        for d in (SESSION_DIR,FIG_DIR,DATA_DIR,REC_DIR,XRAY_DIR):d.mkdir(parents=True,exist_ok=True)
        SESSION_LOG=SESSION_DIR/"SESSION.log";SESSION_EVENTS=SESSION_DIR/"SESSION_EVENTS.jsonl";ENGINE_LOG=SESSION_DIR/"ENGINE.log"
        LIVE_QA=SESSION_DIR/"LIVE_QUERY_ANSWERS.jsonl";LIVE_FILE=DATA_DIR/"LIVE_MEASUREMENTS.json";CHECK_FILE=SESSION_DIR/"VERIFICATION_RECORD.json"
        RUN_SUMMARY=SESSION_DIR/"RUN_SUMMARY.txt";MANIFEST=SESSION_DIR/"SHA256_MANIFEST.json";ZIP_PATH=SESSION_DIR/f"{SESSION_ID}_AKBASCORE_PROMETHEUS_TEST730_DEMO.zip"
        dump_json(REC_DIR/"TEST730_RECORD_PARSED.json",REC);(REC_DIR/"730.log").write_bytes(RAW["730.log"]);(REC_DIR/"730.py").write_bytes(RAW["730.py"])
        slog("NEW_RUN",f"RUN {len(RUNS_DONE)+1} writes only into {SESSION_DIR} (earlier runs: {', '.join(RUNS_DONE)})")
    RUNS_DONE.append(SESSION_ID)
    for k in ("master_memory","master_gpu_cp","master_seals_before"):STATE.pop(k,None)       # no memory of an earlier RUN is reused
    if E.get("release"):
        try:E["release"]()
        except Exception:pass
    keep={k:LIVE[k] for k in ("provenance",) if k in LIVE};LIVE.clear();LIVE.update(keep,session=SESSION_ID)
    LIVE_CHECKS[:]=[c for c in LIVE_CHECKS if c.get("stage") is None]         # keep only the start-up checks; every run records its own
    FIG_FILES.clear();FIG_ERRORS.clear();PROVENANCE.clear();STATE["fig_version"]+=1
def run_verdict():
    st=STATE["stages"];bad=[k for k,v in st.items() if v["status"] in("fail","skip")]
    if STATE.get("running"):return "RUNNING"
    if not STATE.get("finished"):return "NOT STARTED"
    if not bad:return "COMPLETE — every stage ran and passed"
    return "INCOMPLETE — not a completed live experiment: "+", ".join(f"{k} {st[k]['status'].upper()}" for k in bad)
def run_pipeline():
    _new_run_dir()
    STATE.update(running=True,started=utc_now(),finished=None,error=None)
    for k in STAGES:STATE["stages"][k]=dict(status="wait",seconds=None,note="")
    banner(f"RUN · {local_now()} · session {SESSION_ID}");live=False
    try:
        for key,fn in STAGE_FUNCS.items():
            STATE["current"]=key
            if key in GPU_STAGES and not live:stage_set(key,"skip","not run — "+("no A100 80 GB GPU in this runtime (REPLAY MODE)" if STATE["mode"]!="LIVE" else "the model is not loaded"));continue
            bad=[d for d in NEEDS.get(key,()) if STATE["stages"][d]["status"]!="done"]
            if bad:stage_set(key,"skip","not run — requires "+", ".join(bad));continue
            stage_set(key,"run");_emit(f"── [{list(STAGES).index(key)+1}/{len(STAGES)}] {STAGES[key]}");t=time.perf_counter()
            try:
                with GPU_LOCK:r=fn()
                if key=="GPU":
                    live,note=r;stage_set(key,"done" if live else "skip",note,time.perf_counter()-t)
                else:stage_set(key,"done",r,time.perf_counter()-t)
                slog("STAGE_DONE",key,seconds=round(time.perf_counter()-t,2),note=STATE["stages"][key]["note"])
            except Exception as ex:
                tb=traceback.format_exc();stage_set(key,"fail",f"{type(ex).__name__}: {ex}",time.perf_counter()-t)
                slog("STAGE_FAILED",key,error=f"{type(ex).__name__}: {ex}",traceback=tb[-3000:])
                if key=="MODEL":live=False
                if _is_oom(ex):
                    try:E["release"]()
                    except Exception:pass
            try:write_measurements()
            except Exception:pass
    finally:
        STATE.update(running=False,finished=utc_now(),current=None);bump()
        try:
            write_run_summary();dump_json(DATA_DIR/"STAGES.json",dict(verdict=run_verdict(),stages=STATE["stages"],session=SESSION_ID))
            if MANIFEST.is_file():package_session()
        except Exception:pass
        banner(f"RUN VERDICT: {run_verdict()}\nRUN finished {local_now()} · mode {STATE['mode']} · "+" · ".join(f"{k}:{v['status']}" for k,v in STATE["stages"].items()))
RUN_THREAD={"t":None}
def start_run():
    """starts the pipeline once; pressing RUN while it runs only follows the progress"""
    t=RUN_THREAD["t"]
    if t is not None and t.is_alive():return False
    if STATE.get("finished") and STATE["mode"]=="LIVE" and STATE.get("master_memory") is not None:return False   # completed live run: results stay; reload the cell for a new run
    RUN_THREAD["t"]=threading.Thread(target=run_pipeline,daemon=True,name="P730-RUN");RUN_THREAD["t"].start();return True
# ===== END OF PART 2/3 =====
