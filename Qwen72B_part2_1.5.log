        for key_,col_,nm in (("k_layer_mean_body",COL["MASTER"],"‖K‖"),("v_layer_mean_body","#A78BFA","‖V‖")):
            s=np.mean([D[c][2][key_] for c in src],axis=0);mv=np.array(m[key_]);axr.plot((mv-s)/s*100,L,color=col_,lw=1.5,label=nm)
        axr.axvline(0,color=NEU,lw=.8);axr.axhline(3.5,color=NEU,ls="--",lw=.9);axr.set_ylim(0,79);axr.set_xlabel("relative difference (%)",fontsize=8.5);axr.set_ylabel("transformer layer",fontsize=8.5)
        axr.set_title(f"MASTER vs mean of {'+'.join(src)}",fontsize=9.5);axr.legend(fontsize=7.6,loc="upper right");axr.tick_params(labelsize=7.5)
        for s in ("top","right"):axr.spines[s].set_visible(False)
    T(fig,.44,.858,"Differences describe the physical states only — they are not a measure of intelligence, consciousness or a proof of synthesis.",size=8.6,color=INK2,xmax=.965)
    fig_footer(fig,k,"Relative difference per layer = (MASTER − mean of sources) / mean of sources, on the layer means of the body rows (rows after the shared PREFIX). Lengths differ; statistics are per layer.")
    return save_fig(fig,k,"SOURCES_VS_MASTER","LIVE GPU MEASUREMENT",["measurements/xray/XRAY_*.npz","XRAY_SUMMARY.json (k/v_layer_mean_body)"])

