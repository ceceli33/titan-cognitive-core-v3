    rec=card("Recorded TEST730 timings",tbl(rows,["question","seconds","status"])+f"<div class='small'>Fast path: one MASTER initialization {(REC.get('fast_path') or {}).get('init_seconds')} s (load + initialize). "
             f"Model download {esc(REC['model_io'].get('fetch_time'))} · weights load {esc(REC['model_io'].get('load_time'))} (TEST730 record).</div>","info")
    fp=LIVE.get("master_fast_path");md=LIVE.get("model") or {}
    if not fp:return rec+card("Measured in this session","not measured (REPLAY MODE or RUN not finished)","warn")
    rows=[("model load",("reused — already loaded in this kernel" if md.get("reused") else f"{md.get('total_seconds')} s")),("SSD read MASTER.pt",f"{fp['ssd_read_seconds']} s · {fp['ssd_read_mb_s']} MB/s"),("verified load",f"{fp['verified_load_seconds']} s"),
          ("host→GPU",f"{fp['h2d_seconds']} s"),("initialize_native",f"{fp['initialize_native_seconds']} s"),("prefix seals",f"{fp['prefix_seal_seconds']} s")]
    if LIVE.get("parity"):rows.append(("parity",f"{LIVE['parity']['seconds']} s"))
    for qid,r in (LIVE.get("repro") or {}).items():rows.append((f"answer {qid}",f"{r['n_generated']} tok · {r['seconds']} s · {r['tokens_per_second']} tok/s"))
    for qid,v in (LIVE.get("newq") or {}).items():
        for lab in ("master","no_memory"):rows.append((f"{qid} {lab}",f"{v[lab]['n_generated']} tok · {v[lab]['seconds']} s · {v[lab]['tokens_per_second']} tok/s"))
    return rec+card("Measured on the GPU in this session",tbl(rows,mono_cols=(1,)),"on")
def verif_html():
    rows=[(c["name"],Markup(ok_mark(c["passed"])),"" if c["detail"] is None else str(c["detail"])[:120]) for c in REC["checks"]]
    lrows=[(c["name"],Markup(ok_mark(c["passed"])),c.get("stage") or "","" if c["detail"] is None else str(c["detail"])[:120]) for c in LIVE_CHECKS]
    src=[(n,v["git_blob"],v["sha256"],f"{v['bytes']:,}") for n,v in SOURCES.items()]
    return (card(f"Live checks of this session — {sum(c['passed'] for c in LIVE_CHECKS)}/{len(LIVE_CHECKS)} PASS",tbl(lrows,["check","result","stage","detail"],mono_cols=(3,)) if lrows else "none yet (press RUN)","on" if lrows and all(c["passed"] for c in LIVE_CHECKS) else "warn")+
            card("Locked sources (git blob verified at start-up)",tbl(src,["file","git blob","SHA-256","bytes"],mono_cols=(1,2)),"info")+
            details(f"<b>Recorded TEST730 checks — {REC['checks_passed']}/{REC['checks_total']} PASS · result {esc(REC['result'])}</b>",tbl(rows,["check","result","detail"],mono_cols=(2,))))
def live_query_info():
    ok=STATE.get("master_memory") is not None
    return card("LIVE QUERY MODE — ask the mounted MASTER memory",("<b>Ready.</b> Type a question and press <b>Enter</b>. The real model answers from the MASTER cartridge (greedy, up to 768 new tokens, ≈ 7–8 tokens/s on an A100). "
                "Your questions are recorded in LIVE_QUERY_ANSWERS.jsonl and are <b>not</b> part of the sealed TEST730 panel." if ok else
                "Not available yet: the MASTER memory is mounted by RUN on an A100 80 GB GPU. In REPLAY MODE no live answer can be produced, and no recorded answer is shown instead."),"on" if ok else "warn")
def live_answers_html():
    q=LIVE.get("user_queries") or []
    if not q:return ""
    return "".join(card(f"LIVE · {short(r['question'],120)}",f"{r['n_generated']} tokens · {r['seconds']} s · {r['tokens_per_second']} tok/s · {esc(r['utc'][11:19])} UTC"+
                        (" · stopped at the 768-token limit" if r["ceiling_reached"] else "")+pre(r["answer"],460),"on") for r in reversed(q[-10:]))

TABS=["OVERVIEW","REAL SOURCES","PHYSICAL CARTRIDGES","NEURAL X-RAY","MASTER SYNTHESIS","SIX-QUESTION DEMO","ADVANCED REASONING","PERFORMANCE","VERIFICATION","SCIENTIFIC FIGURES","LIVE QUERY"]
TAB_HTML={"OVERVIEW":overview_html,"REAL SOURCES":sources_html,"PHYSICAL CARTRIDGES":cart_html,"NEURAL X-RAY":xray_html,"MASTER SYNTHESIS":synth_html,"SIX-QUESTION DEMO":six_html,
          "ADVANCED REASONING":adv_html,"PERFORMANCE":perf_html,"VERIFICATION":verif_html}
def tab_gallery(tab):
    keys=[k for k,m in FIGURES.items() if (m["tab"]==tab or tab=="SCIENTIFIC FIGURES") and k in FIG_FILES]
    return [(FIG_FILES[k]["jpg"],f"Fig. {FIGURES[k]['n']} — {FIGURES[k]['title']} · {FIG_FILES[k]['badge']}") for k in keys]
def figs_status_html():
    n=len(FIG_FILES);tot=len(FIGURES)
    if not n and not FIG_ERRORS:return card(f"Scientific figures of this RUN — 0/{tot}","The figures are produced by RUN (stage 11). All figures appear here, one below the other, as soon as they are written.","info")
    def st(k):
        f=FIG_FILES.get(k)
        if not f:return "NOT GENERATED: "+str(FIG_ERRORS.get(k,"pending"))
        q=f.get("layout_qc") or {};j=f.get("jpeg_qc") or {}
        return f"{f['badge']} · {f['pixels'][0]}×{f['pixels'][1]} JPEG 300 dpi · layout QC {'PASS' if q.get('passed') else 'FAIL'} · JPEG QC {'PASS' if j.get('passed') else 'FAIL'}"
    rows="".join(f"<div class='small'>{'✓' if k in FIG_FILES and (FIG_FILES[k].get('layout_qc') or {}).get('passed') else '✗'} Fig. {esc(m['n'])} — {esc(m['title'])} · <b>{esc(st(k))}</b></div>" for k,m in FIGURES.items())
    ok=n==tot and all((v.get("layout_qc") or {}).get("passed") for v in FIG_FILES.values())
    return card(f"Scientific figures of this RUN ({SESSION_ID}) — {n}/{tot} written",rows,"on" if ok else "warn")
def file_url(p):return ("/gradio_api/file=" if _GR_MAJOR>=5 else "/file=")+quote(str(p),safe="/")
def file_url_alt(p):return ("/file=" if _GR_MAJOR>=5 else "/gradio_api/file=")+quote(str(p),safe="/")
def figs_main_html():
    """all figures of THIS run, in order Fig. 1 … Fig. 12, Fig. S1 — each with its own direct JPEG download link below it"""
    if not FIG_FILES:return card("Figures","No figure of this RUN yet. They appear here, in order, when stage 11 has written them (figures of an earlier RUN are never shown).","info")
    keys=[k for k in FIGURES if k in FIG_FILES];out=[]
    bulk=("<a href='#' onclick=\"var l=document.querySelectorAll('a.kz-dl');for(var i=0;i<l.length;i++){(function(a,d){setTimeout(function(){a.click()},d)})(l[i],i*900)};return false;\">"
          f"<b>⬇ Download all {len(keys)} figures (JPEG), one after another</b></a>")
    out.append(card("Direct downloads — no ZIP",f"{bulk}<br><span class='small'>The browser downloads the {len(keys)} JPEG files in order (Fig. 1 → Fig. 12 → Fig. S1). Some browsers ask once to "
                    "“allow multiple downloads”; if the browser blocks it, use the link under each figure or the JPEG file list below — every file there downloads with one tap.</span>","on"))
    for k in keys:
        f=FIG_FILES[k];m=FIGURES[k];u=file_url(f["jpg"]);ua=file_url_alt(f["jpg"]);nm=Path(f["jpg"]).name;qc=(f.get("layout_qc") or {}).get("passed")
        out.append(f"<div class='kz card {'on' if qc else 'err'}'><div class='h'>Fig. {esc(m['n'])} — {esc(m['title'])} · {esc(f['badge'])}"+("" if qc else " · LAYOUT QC FAIL")+"</div>"
                   f"<img src='{u}' data-alt='{ua}' onerror=\"if(!this.dataset.done){{this.dataset.done=1;this.src=this.dataset.alt;var a=this.parentNode.querySelector('a.kz-dl');if(a)a.href=this.dataset.alt;}}\" "
                   f"style='width:100%;height:auto;border:1px solid #d1d5db' alt='Fig. {esc(m['n'])}'>"
                   f"<div class='small' style='margin-top:4px'><a class='kz-dl' href='{u}' download='{esc(nm)}'><b>⬇ Download Fig. {esc(m['n'])} (JPEG, {f['pixels'][0]}×{f['pixels'][1]}, 300 dpi)</b></a> · "
                   f"<span class='mono'>{esc(nm)} · SHA-256 {esc(f['sha256_jpg'][:16])}…</span></div></div>")
    return "".join(out)
def jpg_files():return [FIG_FILES[k]["jpg"] for k in FIGURES if k in FIG_FILES]
def _safe(fn):
    try:return fn()
    except Exception as ex:return card("Display error",f"<code>{esc(type(ex).__name__)}: {esc(ex)}</code> — the records are unaffected","err")
def all_files():return [p for _,p in download_items()]
def snapshot(last):
    """the full output tuple; html parts are rebuilt only when the state version changed, galleries only when figures changed"""
    v=STATE["version"];fv=STATE["fig_version"];out=[_safe(mode_html),_safe(stages_html),console_text()]
    if last.get("v")!=v:
        for t in TAB_HTML:out.append(_safe(TAB_HTML[t]))
        last["v"]=v
    else:out+=[gr.update() for _ in TAB_HTML]
    if last.get("fv")!=fv:
        out+=[tab_gallery(t) for t in TABS[:-1]];out+=[all_files() or None,jpg_files() or None,_safe(figs_status_html),_safe(figs_main_html)];last["fv"]=fv
    else:out+=[gr.update() for _ in TABS[:-1]]+[gr.update(),gr.update(),gr.update(),gr.update()]
    out+=[_safe(live_query_info)]
    return tuple(out)
def run_handler():
    start_run();last={};time.sleep(.5)
    while True:
        t=RUN_THREAD["t"];alive=t is not None and t.is_alive()
        yield snapshot(last)
        if not alive:break
        time.sleep(2.0)
    STATE["fig_version"]+=1                     # final refresh: every record file of this RUN is listed
    yield snapshot(last)
def page_load():return snapshot({})
def query_handler(question):
    q=(question or "").strip()
    if not q:yield card("Type a question first","","warn"),live_answers_html();return
    if STATE.get("running"):yield card("RUN in progress","The live query becomes available when RUN has finished (the GPU is in use by the pipeline).","warn"),live_answers_html();return
    if not GPU_LOCK.acquire(blocking=False):yield card("Busy","Another question is being answered on the GPU. Please wait and press Enter again.","warn"),live_answers_html();return
    try:
        yield card("Answering live …",f"MASTER memory mounted · question: {esc(short(q,200))} · up to 768 new tokens","info"),live_answers_html()
        r=live_query(q[:3000])
        try:package_session()
        except Exception as ex:slog("PACKAGE_FAILED",str(ex))
        yield card("Answer of the frozen Qwen2.5-72B from the MASTER memory — raw output, unedited, not graded",f"{r['n_generated']} tokens · {r['seconds']} s","on"),live_answers_html()
    except Exception as ex:
        slog("LIVE_QUERY_ERROR",f"{type(ex).__name__}: {ex}",traceback=traceback.format_exc()[-2000:])
        yield card("Live query not possible",f"<code>{esc(type(ex).__name__)}: {esc(ex)}</code>","err"),live_answers_html()
    finally:GPU_LOCK.release()

def _tb(**kw):
    for extra in (([{"buttons":["copy"]}] if _GR_MAJOR>=6 else [])+[{"show_copy_button":True},{}]):
        try:return gr.Textbox(**extra,**kw)
        except TypeError:continue
def _gallery(**kw):
    try:return gr.Gallery(columns=1,height="auto",object_fit="contain",preview=False,**kw)
    except TypeError:return gr.Gallery(**kw)
def _on(ev,fn,inputs,outputs,limit):
    try:return ev(fn,inputs=inputs,outputs=outputs,concurrency_limit=limit)
    except TypeError:return ev(fn,inputs=inputs,outputs=outputs)
def build_ui():
    blocks=gr.Blocks(title=APP_SHORT) if _GR_MAJOR>=6 else gr.Blocks(css=CSS,title=APP_SHORT)
    with blocks as demo:
        gr.HTML(hero_html());mode=gr.HTML(mode_html())
        run_b=gr.Button("RUN",variant="primary",elem_id="kz_run")
        stg=gr.HTML(stages_html())
        fstat=gr.HTML(_safe(figs_status_html))
        main_figs=gr.HTML(_safe(figs_main_html))
        jpgs=gr.File(label="The JPEG figures of this RUN, in order (Fig. 1 … Fig. 12, Fig. S1) — each file downloads with one tap",value=(jpg_files() or None),file_count="multiple",interactive=False)
        con=_tb(lines=10,max_lines=18,label="Live log of this RUN — written while the engine works (time · stage · event · measured value); also SESSION.log / SESSION_EVENTS.jsonl / ENGINE.log",value=console_text(),interactive=False)
        files=gr.File(label="Real-time logs, live measurements, SHA-256 verification record, cartridge record, X-ray summary, provenance table, manifest — direct downloads (no ZIP)",value=(all_files() or None),file_count="multiple",interactive=False)
        htmls={};gals={}
        with gr.Tabs():
            for t in TABS:
                with gr.Tab(t):
                    if t in TAB_HTML:htmls[t]=gr.HTML(_safe(TAB_HTML[t]))
                    if t=="SCIENTIFIC FIGURES":gr.HTML(card("Scientific figures","All 13 figures of this RUN in high resolution (JPEG, 300 dpi). Each figure carries its badge and a provenance entry (PROVENANCE_TABLE.csv). Direct downloads are on the main page.","info"))
                    if t=="LIVE QUERY":
                        lq_info=gr.HTML(live_query_info());qbox=gr.Textbox(label="Your question to the MASTER memory — press Enter (not part of the sealed panel)",lines=2,max_lines=6)
                        lq_status=gr.HTML("");lq_hist=gr.HTML(live_answers_html())
                    else:gals[t]=_gallery(label=f"{t} · figures",value=tab_gallery(t))
        gr.HTML(f'<div class="kz small" style="opacity:.8;margin:10px 0 18px">{esc(AUTHOR)} · {esc(ORG)} · {esc(LICENSE_NAME)} · {esc(COPYRIGHT)} · '
                f'<a href="{URL_730}" target="_blank" rel="noopener">730.py</a> · <a href="{URL_730LOG}" target="_blank" rel="noopener">730.log</a> · <a href="{URL_709}" target="_blank" rel="noopener">709.py</a> · '
                f'<a href="{URL_716}" target="_blank" rel="noopener">716.py</a> · <a href="{URL_LICENSE}" target="_blank" rel="noopener">LICENSE</a> · articles CC BY 4.0 © their authors · '
                'Qwen2.5-72B-Instruct and third-party libraries remain under their own licences.</div>')
        outs=[mode,stg,con]+[htmls[t] for t in TAB_HTML]+[gals[t] for t in TABS[:-1]]+[files,jpgs,fstat,main_figs,lq_info]
        _on(run_b.click,run_handler,None,outs,8)
        _on(qbox.submit,query_handler,[qbox],[lq_status,lq_hist],1)
        try:demo.load(page_load,inputs=None,outputs=outs)
        except Exception:pass
    try:demo.queue(default_concurrency_limit=8)
    except TypeError:
        try:demo.queue(concurrency_count=8)
        except TypeError:demo.queue()
    return demo

_GR_MAJOR=int(re.match(r"\d+",gr.__version__).group())
GRADIO_LINK=DEMO_ROOT/"GRADIO_LINK.txt"
demo=None
def launch_interface():
    """(re)opens the interface of THIS session (public link first, Colab port window as fallback); nothing is recomputed.
    If the link stops working, run  launch_interface()  in a new cell."""
    global demo
    try:demo.close()
    except Exception:pass
    demo=build_ui()
    kw=dict(share=True,allowed_paths=[str(DEMO_ROOT)],show_error=True,inline=False,prevent_thread_lock=True,debug=False)
    if _GR_MAJOR>=6:kw["css"]=CSS
    err=None
    for _ in range(6):
        try:demo.launch(**kw);break
        except TypeError as ex:
            bad=next((k for k in ("css","prevent_thread_lock","allowed_paths","debug") if k in str(ex) and k in kw),None)
            if bad is None:raise
            kw.pop(bad)
        except Exception as ex:
            if not kw.get("share"):raise
            err=f"{type(ex).__name__}: {ex}";kw["share"]=False;slog("LAUNCH_NOTE","public share link not available — opening the local interface",error=err)
    share=getattr(demo,"share_url",None);local=getattr(demo,"local_url",None);window=None
    if not share:
        try:
            from google.colab import output as _co
            port=int(re.search(r":(\d+)",str(local)).group(1));_co.serve_kernel_port_as_window(port,anchor_text="▶ Open the AKBASCORE PROMETHEUS TEST730 interface (Colab window)");window=f"Colab port window, port {port}"
        except Exception as ex:window=f"not available ({type(ex).__name__})"
    dump_json(GRADIO_LINK.with_suffix(".json"),dict(utc=utc_now(),session=SESSION_ID,share_url=share,local_url=local,colab_window=window,share_error=err))
    GRADIO_LINK.write_text(f"{share or local}\n",encoding="utf-8")
    banner(f"INTERFACE OPEN · {share or ('local only: '+str(local))}\n  public link : {share or '— (tunnel not available; use the Colab window link above)'}\n  local       : {local}\n"
           f"  Press RUN in the interface — everything else runs automatically. If the link stops working: run  launch_interface()  in a new cell.","#")
    slog("LAUNCH","interface open",share_url=share,local_url=local,colab_window=window);return share or local
def keep_cell_running():
    """keeps this Colab cell RUNNING while the interface is in use (as in the earlier demonstrations): the RUN progress, the
    model download / loading bars and every stage are printed below; stop the cell (■) to close the interface"""
    files_note=("TEST730 cartridge files found in this runtime: "+", ".join(f"{c} {ART[c]['status'].lower()}" for c in CARTS)) if any(ART[c]["status"]!="MISSING" for c in CARTS) else \
               ("TEST730 cartridge files are NOT in this runtime (new Colab VM). RUN will load Qwen2.5-72B on the GPU and FORGE P01, P02, P03 and MASTER with the unchanged "
                "730.py commit() from their SHA-verified sealed texts, then verify them by SHA-256 before any live use.")
    banner("THE CELL STAYS RUNNING — the interface is live. Press RUN in the interface; all stages are printed here and shown in the interface.\n  "+files_note+
           "\n  Stop this cell (■) only when you have finished; the session files stay in "+str(SESSION_DIR),"#")
    try:demo.block_thread()
    except (KeyboardInterrupt,AttributeError):
        try:
            while True:time.sleep(5)
        except KeyboardInterrupt:pass
    finally:
        slog("CELL_STOPPED","the cell was stopped by the user")

# ---------------------------------------------------------------------------------------------------------------------
# START-UP: locked sources, the TEST730 record, the engine definitions, the TEST730 files — then the interface opens
# ---------------------------------------------------------------------------------------------------------------------
try:startup()
except Exception as _ex:
    _m=str(_ex)
    _hint=("A locked source changed on GitHub — the program stops instead of running unverified code." if "LOCKED SOURCE" in _m else
           "The TEST730 record could not be parsed as expected — nothing is shown instead of it." if "PARSER" in _m or "PANEL" in _m else
           "Network error while downloading a locked source from GitHub: run the cell again." if any(x in _m for x in ("URLError","timed out","HTTP Error","Connection","Name or service")) else
           "See the traceback above; nothing was changed in the engine or in the TEST730 files.")
    banner(f"START-UP FAILED — {type(_ex).__name__}: {_m}\nWHAT TO DO: {_hint}\nRecords of this attempt: {SESSION_DIR}","!")
    raise
launch_interface()
if os.environ.get("P730_NO_BLOCK")!="1":keep_cell_running()
