def hero_html():
    s=REC.get("summary") or {}
    tiles=[("3","real CC BY 4.0 articles"),("4","physical cartridges"),(f"{REC['body_tokens']['MASTER']:,}","MASTER tokens"),("6/6","responses generated"),("80/80","layer parity (record)"),
           ("NOT YET","independently graded")]
    return (f'<div class="kz hero"><span class="rec">Live research demonstration · frozen Qwen2.5-72B-Instruct · NF4 · BF16 · CUT3 · A100 80 GB</span>'
            f'<div class="brand">{esc(APP_NAME)}</div><div class="title">{esc(APP_SUB)}</div>'
            f'<div class="by">TEST730 · three real 2026 publications → three physical source cartridges → model readouts → textual synthesis → MASTER cartridge → six sealed questions. '
            f'Recorded result <b>{esc(REC["result"])}</b> · panel SHA-256 <span class="mono">{esc(REC["panel_sha256"][:16])}…</span></div>'
            '<div class="tiles">'+"".join(f'<div class="tile"><b>{esc(a)}</b><span>{esc(b)}</span></div>' for a,b in tiles)+'</div>'
            f'<div class="by"><b>{esc(AUTHOR)}</b> · {esc(ORG)} · {esc(PLACE)} · {esc(LICENSE_NAME)} · {esc(COPYRIGHT)} · <a href="{REPO}" target="_blank" rel="noopener">{esc(REPO)}</a></div></div>')
def mode_html():
    st=STATE;run=st.get("running");m=st["mode"]
    if SIM:kind,t="err","SIMULATION STACK — code test of the author, NOT an experimental result"
    elif run:kind,t="info",f"RUN IN PROGRESS — stage {list(STAGES).index(st['current'])+1 if st.get('current') else '…'}/{len(STAGES)}: {STAGES.get(st.get('current'),'')}"
    elif st.get("finished") and m=="LIVE" and st.get("master_memory") is not None and all(v["status"]=="done" for v in st["stages"].values()):kind,t="on","LIVE MODE — RUN completed on the GPU · the MASTER memory is mounted · LIVE QUERY tab answers new questions"
    elif st.get("finished") and m=="LIVE":kind,t="err",f"{run_verdict()} — failed or skipped stages are not shown as results; the reason of each is in the stage list and the log"
    elif st.get("finished"):kind,t="warn","REPLAY MODE — RUN completed without a GPU: recorded TEST730 results + CPU verification only"
    else:kind,t="info","NOT STARTED — only the recorded TEST730 results are shown (no GPU used yet). Press RUN: Qwen2.5-72B is loaded on the GPU, the cartridges are verified or forged, and every stage runs live."
    f=", ".join(f"{c} {(ART.get(c) or {}).get('status','—').replace('_',' ').lower()}" for c in CARTS)
    miss=all((ART.get(c) or {}).get("status")=="MISSING" for c in CARTS) and not st.get("running") and not st.get("finished")
    f+=(" → RUN will forge them with the unchanged 730.py commit() on the GPU" if miss else "")
    return card(t,f"TEST730 files in this runtime: {esc(f)}<br>Recorded results are documentation of the completed TEST730 run; everything measured in this session is labelled <b>LIVE</b>. "
                "New questions are never counted as part of the sealed six-question panel.",kind)
def stages_html():
    out=[];n=len(STAGES);done=0
    for i,(k,title) in enumerate(STAGES.items(),1):
        s=STATE["stages"][k];stt=s["status"];mk={"done":"✓","run":"▶","fail":"✗","skip":"–","wait":"○"}[stt]
        if stt in("done","skip","fail"):done+=1
        tm=f" · {s['seconds']:.0f} s" if s.get("seconds") is not None else ""
        out.append(f"<div class='stg {stt}'>{mk} {i}/{n} · {esc(title)}{tm}"+(f"<span class='nt'>{esc(s['note'])}</span>" if s.get("note") else "")+"</div>")
    pc=100*done/n
    bar=f'<div style="margin-top:6px;background:#e5e7eb;height:10px;border-radius:2px"><div style="width:{pc:.0f}%;height:10px;background:#7626D9;border-radius:2px"></div></div>'
    head=(f"RUN {len(RUNS_DONE) or ''} · {run_verdict()} · "+"Stages"+(f" · started {STATE['started'][11:19]} UTC" if STATE.get("started") else " · not started")+(f" · finished {STATE['finished'][11:19]} UTC" if STATE.get("finished") else ""))
    return card(head,"".join(out)+bar,"m")
def console_text():
    with _LOG_LOCK:return "\n".join(list(CONSOLE)[-160:])

def overview_html():
    rc=lambda n:_rec_check(n);lv=lambda n:_live_check(n)
    steps=[("Three articles were given","3 real 2026 articles (CC BY 4.0) from Europe PMC; excerpts sealed by SHA-256",rc("THREE_DISTINCT_SOURCES"),(LIVE.get("sources") and all(v.get("excerpt_equal") for v in LIVE["sources"].values())) or None),
           ("Each became a physical neural memory","P01, P02, P03 forged with native CUT3: H3 + L0–L3 K/V on the SSD",rc("THREE_PHYSICAL_SOURCES"),
            (all((ART.get(c) or {}).get("equal_record") for c in SRC_IDS) if STATE["stages"]["CARTRIDGES"]["status"]=="done" else None)),
           ("The model read each memory","each source mounted alone; one general reading prompt → a reflection (model text)",all(rc(f"SOURCE_REFLECTION_NONEMPTY_{c}") for c in SRC_IDS),None),
           ("The model wrote a new synthesis",f"from the three reflections as text: {REC['synthesis_chars']:,} characters (no tensor fusion)",rc("SYNTHESIS_NONEMPTY"),None),
           ("The synthesis became a new MASTER memory",f"MASTER cartridge {REC['body_tokens']['MASTER']:,} tokens, commit SHA-256 {REC['commits']['MASTER']['sha256'][:12]}…",rc("FOUR_PHYSICAL_CARTRIDGES"),
            ((ART.get("MASTER") or {}).get("equal_record") if STATE["stages"]["CARTRIDGES"]["status"]=="done" else None)),
           ("The source memories were preserved","P01–P03 stay on the SSD while only MASTER is active",rc("ALL_PHYSICAL_SOURCES_PRESERVED"),lv("ALL_PHYSICAL_CARTRIDGES_PRESERVED")),
           ("Six sealed questions went to MASTER","3 human-level + 3 advanced; panel sealed before any source or model access",rc("SEALED_QUESTIONS_UNCHANGED"),ENGINE_INFO.get("panel_rederived_sha256")==REC["panel_sha256"]),
           ("The model answered all six","6/6 responses generated · independent correctness NOT YET GRADED",(REC.get("summary") or {}).get("answered_nonempty")==6,
            (all(v["identical_to_record"] for v in LIVE["repro"].values()) if LIVE.get("repro") else None))]
    def lv8(i,l):
        if i==8 and l is False:return "<b style='color:#B45309'>DIFFERS</b>"
        return ok_mark(l)
    rows=[(Markup(f"<b>{i}. {esc(a)}</b><br><span class='small' style='opacity:.85'>{esc(b)}</span>"),Markup(ok_mark(r)),Markup(lv8(i,l))) for i,(a,b,r,l) in enumerate(steps,1)]
    note=("<br><span class='small'>“This session” for step 8 = live reproduction of H1 and A1: PASS = byte-identical to the record; DIFFERS = the live answer is not byte-identical "
          "(the recorded answers remain the official TEST730 answers; see SIX-QUESTION DEMO).</span>" if LIVE.get("repro") else "")
    sc=card("Scope of the evidence","Verified: physical neural memory persistence · model-generated textual synthesis · MASTER creation and reuse · frozen-weight operation. "
            "Not yet independently established: zero-prompt autonomous learning (TEST730 uses general programmed prompts) · hallucination elimination · superhuman reasoning (no human baseline) · "
            "semantic correctness of the six responses (not graded).","warn")
    lin=card("Research lineage (published records — not results of this experiment)","<br>".join(f"{esc(t)} · <a href='{u}' target='_blank' rel='noopener'>{esc(u)}</a>" for t,u in LINEAGE)+
             f"<br>This experiment: TEST730 — <a href='{URL_730}' target='_blank' rel='noopener'>730.py</a> · <a href='{URL_730LOG}' target='_blank' rel='noopener'>730.log</a> · unpublished, no DOI","info")
    return card("What happened — for every viewer",tbl(rows,["step","TEST730 record","this session"])+note,"m")+sc+lin
def sources_html():
    out=[]
    for c in SRC_IDS:
        s=REC["sources"][c];L=(LIVE.get("sources") or {}).get(c) or {};at=L.get("attribution") or {}
        rows=[("title",s["title"]),("PMCID",s["pmcid"]),("licence",Markup(f"<a href='{s['license']}' target='_blank' rel='noopener'>CC BY 4.0</a> · {esc(s['license'])}")),
              ("resolved (730.py)",s["resolved_url"]),("published",s["published"]),("excerpt",f"{s['excerpt_chars']:,} characters · SHA-256 {s['excerpt_sha256']}"),
              ("full XML SHA-256 (record)",s.get("full_html_sha256")),("body tokens / cartridge",f"{REC['body_tokens'][c]:,} tokens · commit SHA-256 {REC['commits'][c]['sha256']}")]
        if c in REC["rejections"]:rows.append(("replacement",f"originally planned {s.get('original_url_rejected') or s['url']} was rejected: {REC['rejections'][c]} → disclosed Europe PMC replacement"))
        if L:
            rows+= [("re-read now",Markup(("✓ excerpt byte-identical to the record" if L.get("excerpt_equal") else "✗ "+esc(L.get("error") or "excerpt differs from the record"))+
                     f" · full XML {'identical' if L.get('full_xml_equal') else 'changed upstream / not compared'} · {esc(L.get('utc',''))}")),
                    ("authors (XML now)",", ".join(at.get("authors") or []) or "—"),("journal · DOI",f"{at.get('journal') or '—'} · {at.get('doi') or '—'}")]
        else:rows.append(("re-read now","not run in this session (RUN performs it)"))
        out.append(card(f"{c} · {TOPIC[c]} (editorial label)",tbl(rows,mono_cols=(1,)),"info"))
    return "".join(out)+card("Licence and attribution","All three articles are published under CC BY 4.0. The excerpts were used unmodified as cartridge text (sealed_sources/P0x.txt in the TEST730 run). © the respective authors.","on")
def cart_html():
    rows=[]
    for c in CARTS:
        a=ART.get(c) or {};f=a.get("facts") or {}
        rows.append((Markup(chip(c)),(a.get("status") or "—").replace("_"," ").lower(),a.get("origin") or "—",fmt_b(a.get("bytes")),
                     Markup(f"record {esc(REC['commits'][c]['sha256'])}<br>now&nbsp;&nbsp;&nbsp; {esc(a.get('sha256_now') or '—')}"),
                     (f"n={f['n']:,} (P {f['p']} + {f['body_tokens']:,}) · H3 {tuple(f['h_shape'])} · K/V 4×{tuple(f['k_shape'])}" if f else "—"),a.get("tensor_check") or "—"))
    t=tbl(rows,["cartridge","status","origin","file","SHA-256","tensors (measured)","verification"],mono_cols=(4,5))
    root=ORIG.get("root");mc=ORIG.get("manifest_checks") or {};rc=ORIG.get("results_checks") or {}
    info=(f"TEST730 run directory in this runtime: <span class='mono'>{esc(root or 'not found')}</span><br>"+
          (f"manifest: question SHA {ok_mark(mc.get('question_sha'))} · engine locks {ok_mark(mc.get('engine_locks'))} · commits = log {esc(mc.get('commits_equal_log'))}<br>" if mc else "manifest: not available<br>")+
          (f"results.json: answers = log {esc(rc.get('answers_equal_log'))} · synthesis = log {ok_mark(rc.get('synthesis_equal_log'))} · baseline available {esc(rc.get('baseline_available'))}<br>" if rc else "results.json: not available<br>")+
          "The TEST730 directory is only read. If a cartridge file is not present in this runtime (e.g. a new Colab VM), RUN re-forges it with the unchanged 730.py <code>commit()</code> from its "
          "SHA-verified sealed text into a separate folder (<span class='mono'>"+esc(RECOVERY_DIR)+"</span>) — no text is generated, the MASTER text is the recorded synthesis — and compares the "
          "new file SHA-256 with the TEST730 commit record. A different file hash is reported as such, never as identical.")
    fp=LIVE.get("master_fast_path")
    fpt=card("MASTER fast path (live)",tbl([(k,v) for k,v in fp.items() if k not in("gpu",)],mono_cols=(1,)),"on") if fp else card("MASTER fast path (live)","not run in this session","warn")
    return card("Physical cartridges P01 · P02 · P03 · MASTER",t,"m")+card("Where the files come from",info,"info")+fpt
def xray_html():
    X=LIVE.get("xray") or {}
    if not X:return card("Neural X-ray","Not measured in this session. The X-ray is a separate read-only stage of RUN on the GPU: each cartridge is mounted alone with the unchanged initialize_native and the norms "
                         "of its real K/V tensors are read for all 80 layers. TEST730.log contains no X-ray tensors, so no heat map is drawn without this measurement.","warn")
    rows=[]
    for c in CARTS:
        m=X.get(c)
        if not m:rows.append((Markup(chip(c)),"not measured","","","",""));continue
        k=np.array(m["k_layer_mean_body"]);v=np.array(m["v_layer_mean_body"])
        rows.append((Markup(chip(c)),f"{m['rows']:,} rows · prefix {m['prefix_tokens']}",f"{k[:4].mean():.2f} / {k[4:].mean():.2f}",f"{v[:4].mean():.2f} / {v[4:].mean():.2f}",f"{m['seconds']} s",m["mounted"]))
    return card("Neural X-ray — read-only measurement of the real K/V tensors (this session)",tbl(rows,["cartridge","memory","mean ‖K‖ L0–3 / L4–79","mean ‖V‖ L0–3 / L4–79","time","mounted"])+
                f"<div class='small' style='margin-top:6px'>Method: {esc(next(iter(X.values()))['method'])}. Matrices: measurements/xray/XRAY_*.npz (80 × rows, float32).</div>","on")
def synth_html():
    rp=ENGINE_INFO.get("reading_prompt","");sp=ENGINE_INFO.get("synthesis_prompt_source") or ""
    s=card("Programmed prompts of TEST730 (730.py, unchanged)",f"<b>Reading prompt</b> (identical for P01–P03):{pre(rp,120)}<b>Synthesis prompt</b> (730.py source code; the three reflections were inserted as text):{pre(sp,200)}"
           "These are general instructions; no answer key, question of the sealed panel or preferred conclusion was given. TEST730 is therefore an orchestrated reading/synthesis pipeline, not zero-prompt autonomous learning.","info")
    r="".join(details(f"{chip(c)} reflection — {len(REC['reflections'][c]):,} characters · SHA-256 {REC['reflection_sha256_log_text'][c][:16]}…",pre(REC["reflections"][c],520)) for c in SRC_IDS)
    syn=details(f"MODEL SYNTHESIS — {REC['synthesis_chars']:,} characters · SHA-256 {REC['synthesis_sha256_log_text'][:16]}… · recorded text ends mid-sentence (768-token generation limit)",pre(REC["synthesis"],620),True)
    mb=build_master_body([dict(id=c,reflection=REC["reflections"][c]) for c in SRC_IDS],REC["synthesis"])
    mbt=(LIVE.get("recorded_synthesis_tokens"),)
    comp=card("MASTER body (730.py master_body expression)",f"{len(mb):,} characters · SHA-256 {sha_text(mb)[:16]}… · recorded MASTER body: {REC['body_tokens']['MASTER']:,} tokens"
              +("" if not ORIG.get("manifest") else " · manifest body SHA-256 "+esc(next((e.get('body_sha256','')[:16] for e in ORIG['manifest'].get('cartridges',[]) if e.get('id')=='MASTER'),'—'))+"…")
              +details("show the MASTER body text",pre(mb,520)),"m")
    return s+card("Three model readouts (recorded, verbatim)",r,"m")+card("The synthesis (recorded, verbatim)",syn,"m")+comp
def six_html():
    re_ok=ENGINE_INFO.get("panel_rederived_sha256")==REC["panel_sha256"]
    head=(f"Panel SHA-256 (record) <span class='mono'>{esc(REC['panel_sha256'])}</span><br>re-derived in this session from 730.py QUESTION_SET: {ok_mark(re_ok)} · "
          "<b>6/6 responses generated</b> · <b style='color:#B45309'>Independent correctness: NOT YET GRADED</b>")
    out=[card("Six presealed academic questions — asked to MASTER alone (recorded TEST730 answers)",head,"m")]
    base={b["id"]:b["answer"] for b in ((ORIG.get("results") or {}).get("no_memory_baseline") or [])}
    for qid,q in REC["questions"].items():
        inner=f"<div class='small'><b>{esc(q['question'])}</b><br>{q['seconds']} s · {esc(answer_status(qid))} · answer SHA-256 {esc(q['answer_sha256_log_text'][:16])}…</div>"+pre(q["answer"],460)
        r=(LIVE.get("repro") or {}).get(qid)
        if r:inner+=card(f"LIVE reproduction in this session — {'byte-identical to the record' if r['identical_to_record'] else 'differs after %d identical characters'%r['common_prefix_chars']}",
                         f"{r['n_generated']} tokens · {r['seconds']} s · {r['tokens_per_second']} tok/s · SHA-256 {esc(r['sha256'][:16])}…"+("" if r["identical_to_record"] else pre(r["answer"],300)),"on" if r["identical_to_record"] else "warn")
        if qid in base:inner+=details("no-memory baseline (TEST730 results.json)",pre(base[qid],300))
        out.append(details(f"<b>{esc(qid)}</b> · {'human-level' if qid.startswith('H') else 'advanced'} · {esc(short(q['question'],110))}",inner,qid=="H1"))
    if not base:out.append(card("No-memory baseline","The TEST730 no-memory baseline is stored only in TEST730_results.json, which is not available in this runtime (it is not printed in 730.log). Nothing is shown in its place.","warn"))
    return "".join(out)
def adv_html():
    s=card("Model-generated hypotheses","A1–A3 are proposals generated by the model from the MASTER memory. They are not results established by P01–P03, and they have not been independently validated. "
