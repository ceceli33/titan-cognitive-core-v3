# locked sources from the repository (git blob check; a changed file stops the program instead of being trusted)
# ---------------------------------------------------------------------------------------------------------------------
SOURCES={}
def fetch_locked(name,timeout=180):
    p=EVID_DIR/name
    if p.is_file() and git_blob(p.read_bytes())==LOCKS[name]:raw=p.read_bytes()
    else:
        req=urllib.request.Request(RAW_BASE+name,headers={"User-Agent":"AKBASCORE-PROMETHEUS-DEMO"})
        with urllib.request.urlopen(req,timeout=timeout) as f:raw=f.read()
        if git_blob(raw)!=LOCKS[name]:
            raise RuntimeError(f"LOCKED SOURCE CHANGED: {name} git blob {git_blob(raw)} != {LOCKS[name]} — the program stops instead of using an unverified file")
        p.write_bytes(raw)
    SOURCES[name]=dict(bytes=len(raw),git_blob=git_blob(raw),sha256=sha_bytes(raw),url=RAW_BASE+name,local=str(p),verified_utc=utc_now())
    return raw

# ---------------------------------------------------------------------------------------------------------------------
# THE RECORDED TEST730 EXPERIMENT — parsed read-only from the locked 730.log (REPLAY source)
# ---------------------------------------------------------------------------------------------------------------------
_TAGS=("QUESTION_PANEL_PRESEALED_SHA256","PASS","FAIL","SOURCE_PRIMARY_REJECTED","SOURCE_EXPLICIT_REPLACEMENT","SOURCE_CANDIDATE_REJECTED","SOURCE_LOCK",
       "PHYSICAL_COMMIT","READING_REFLECTION","MODEL_SYNTHESIS","DEMO_FAST_PATH_READY","DEMO_QUESTION_SECONDS","DEMO_QUESTION","DEMO_ANSWER",
       "TEST730_RESULT","SUMMARY","RESULT_JSON","TEST730_ERROR")
_START=re.compile(r"^(?:.*?(?:it/s|B/s)\])?("+"|".join(_TAGS)+r")(?: |$)(.*)$")
_MULTI=("READING_REFLECTION","MODEL_SYNTHESIS","DEMO_ANSWER","TEST730_ERROR")
def _lit(s):
    try:return ast.literal_eval(s.strip()) if s and s.strip() else None
    except Exception:return s.strip() or None
def parse_730_log(text):
    """returns the recorded experiment exactly as the log states it; multi-line texts are reproduced byte-exact
    (730.py writes ' '.join(items)+'\\n' and the engine strips every generated text)"""
    entries=[];cur=None
    for line in text.split("\n"):
        m=_START.match(line)
        if m:
            cur=[m.group(1),[m.group(2)]];entries.append(cur)
        elif cur is not None and cur[0] in _MULTI:cur[1].append(line)
    while entries and entries[-1][0] in _MULTI and entries[-1][1] and entries[-1][1][-1]=="":entries[-1][1].pop()
    R=dict(checks=[],sources={},rejections={},replacements={},commits={},body_tokens={},reflections={},questions=OrderedDict(),raw_entries=len(entries))
    for tag,lines in entries:
        first=lines[0];body="\n".join(lines)
        if tag=="QUESTION_PANEL_PRESEALED_SHA256":R["panel_sha256"]=first.strip()
        elif tag in("PASS","FAIL"):
            nm,_,det=first.partition(" ");R["checks"].append(dict(name=nm,passed=(tag=="PASS"),detail=_lit(det)))
        elif tag=="SOURCE_LOCK":
            d=json.loads(first);R["sources"][d["id"]]=d
        elif tag=="SOURCE_PRIMARY_REJECTED":
            i,_,why=first.partition(" ");R["rejections"][i]=why
        elif tag=="SOURCE_EXPLICIT_REPLACEMENT":
            p=first.split(" ");R["replacements"][p[0]]=dict(pmcid=p[1],license=p[-1],title=" ".join(p[2:-1]))
        elif tag=="PHYSICAL_COMMIT":
            i,role,s=first.split(" ");R["commits"][i]=dict(role=role,sha256=s)
        elif tag=="READING_REFLECTION":
            i,_,t=body.partition(" ");R["reflections"][i]=t
        elif tag=="MODEL_SYNTHESIS":R["synthesis"]=body
        elif tag=="DEMO_FAST_PATH_READY":R["fast_path"]=_lit(first)
        elif tag=="DEMO_QUESTION":
            i,_,q=first.partition(" ");R["questions"].setdefault(i,{})["question"]=q
        elif tag=="DEMO_ANSWER":
            i,_,t=body.partition(" ");R["questions"].setdefault(i,{})["answer"]=t
        elif tag=="DEMO_QUESTION_SECONDS":
            i,_,s=first.partition(" ");R["questions"].setdefault(i,{})["seconds"]=float(s)
        elif tag=="TEST730_RESULT":R["result"]=first.strip()
        elif tag=="SUMMARY":R["summary"]=_lit(first)
        elif tag=="RESULT_JSON":R["result_paths"]=first.split()
    for c in R["checks"]:
        m=re.fullmatch(r"NONEMPTY_BODY_(\w+)",c["name"])
        if m and isinstance(c["detail"],dict):R["body_tokens"][m.group(1)]=c["detail"].get("tokens")
    env=next((c["detail"] for c in R["checks"] if c["name"]=="CUDA_AVAILABLE"),None) or {}
    R["env"]=dict(torch=env.get("torch") if isinstance(env,dict) else None,cuda=env.get("cuda") if isinstance(env,dict) else None,
                  gpu=next((c["detail"] for c in R["checks"] if c["name"]=="A100_80GB"),None),
                  arch=next((c["detail"] for c in R["checks"] if c["name"]=="ARCH"),None))
    flat=text.replace(" "," ")
    def grab(rx):
        m=re.search(rx,flat);return m.group(1) if m else None
    R["model_io"]=dict(download=grab(r"Download complete:\s+([\d.]+\s*[GM]B)"),reconstructed=grab(r"Reconstruction complete:\s+100%\s+([\d.]+\s*GB)"),
                       fetch_time=grab(r"Fetching \d+ files: 100%\s+\d+/\d+\s+\[([\d:]+)<"),shards=grab(r"Fetching (\d+) files: 100%"),
                       load_time=grab(r"Loading weights: 100%\s+\d+/\d+\s+\[([\d:]+)<"),tensors=grab(r"Loading weights: 100%\s+(\d+)/"))
    for i,q in R["questions"].items():
        a=q.get("answer","");q["answer_sha256_log_text"]=sha_text(a);q["chars"]=len(a)
        q["ends_cleanly"]=bool(re.search(r"[.!?)\]\"'`*]\s*$",a.strip()))
    s=R.get("synthesis","");R["synthesis_sha256_log_text"]=sha_text(s);R["synthesis_chars"]=len(s)
    R["synthesis_ends_cleanly"]=bool(re.search(r"[.!?)\]\"'`*]\s*$",s.strip()))
    R["reflection_sha256_log_text"]={k:sha_text(v) for k,v in R["reflections"].items()}
    R["checks_passed"]=sum(c["passed"] for c in R["checks"]);R["checks_total"]=len(R["checks"])
    return R
def parser_selfcheck(R):
    probs=[]
    if R.get("panel_sha256")!=ANCHORS["panel"]:probs.append("panel")
    for k,v in ANCHORS["commit"].items():
        if (R["commits"].get(k) or {}).get("sha256")!=v:probs.append("commit "+k)
    for k,v in ANCHORS["tokens"].items():
        if R["body_tokens"].get(k)!=v:probs.append("tokens "+k)
    for k,v in ANCHORS["pmcid"].items():
        if (R["sources"].get(k) or {}).get("pmcid")!=v:probs.append("pmcid "+k)
    if R.get("result")!=ANCHORS["result"]:probs.append("result")
    if tuple(R["questions"])!=ANCHORS["questions"]:probs.append("questions")
    syn=next((c["detail"] for c in R["checks"] if c["name"]=="SYNTHESIS_NONEMPTY"),None)
    if syn!=R.get("synthesis_chars"):probs.append(f"synthesis length {R.get('synthesis_chars')} != logged {syn}")
    if any(not R["questions"][i].get("answer") for i in R["questions"]):probs.append("answer text")
    if len(R["reflections"])!=3:probs.append("reflections")
    if probs:raise RuntimeError("TEST730 RECORD PARSER CHECK FAILED: "+", ".join(probs))
    return True

