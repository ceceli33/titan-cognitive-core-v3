    qs=json.dumps(E["QUESTION_SET"],ensure_ascii=False,indent=2,default=str).encode()   # = bytes 730.py wrote to SEALED_QUESTIONS.json
    ENGINE_INFO.update(f709=sorted(NAMES_709),f730=list(NAMES_730_FN),constants={k:(str(E[k]) if k in("DTYPE","DEV","CC_RE") else E[k]) for k in NAMES_730_CONST if k not in("HUMAN","ADVANCED","QUESTION_SET")},
                       panel_rederived_sha256=sha_bytes(qs),panel_rederived_bytes=len(qs),prefix=E["PREFIX"],defined_utc=utc_now(),
                       note="709.py and 730.py functions executed unchanged from the locked files; only log/save/check write to this session's records")
