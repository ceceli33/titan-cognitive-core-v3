                                             "Colab: Runtime → Change runtime type → A100 GPU, then run the cell again.")
    E["check"]("CUDA_AVAILABLE",torch.cuda.is_available(),{"torch":torch.__version__,"cuda":getattr(torch.version,"cuda",None)});E["check"]("ONE_GPU",torch.cuda.device_count()==1)
    E["check"]("A100_80GB",torch.cuda.get_device_properties(0).total_memory>=70*2**30,torch.cuda.get_device_name(0))
    STATE["mode"]="LIVE";return True,f"{rep['name']} · {rep['total_gib']} GiB · torch {rep['torch']} · transformers {rep['transformers']}"

def _hf_cache_bytes():
    try:
        from huggingface_hub.constants import HF_HUB_CACHE
        d=Path(HF_HUB_CACHE)/("models--"+MODEL_ID.replace("/","--"))
        return sum(f.stat().st_size for f in d.rglob("*") if f.is_file()) if d.is_dir() else 0
    except Exception:return None
def _heartbeat(stop,t0):
    while not stop.wait(30):
        b=_hf_cache_bytes();el=time.perf_counter()-t0
        STATE["stages"]["MODEL"]["note"]=f"downloading / loading … {el/60:.1f} min · model files in the Hugging Face cache: {('%.1f GB'%(b/1e9)) if b is not None else '—'}";bump()
        slog("MODEL_PROGRESS",f"{el/60:.1f} min",hf_cache_gb=(round(b/1e9,1) if b is not None else None))
def _kernel_model():
    """the model object left in this Python kernel by a TEST730 run (730.py keeps `model` and `tok` as globals)"""
    g=globals();m=g.get("model");t=g.get("tok")
    try:
        if m is None or t is None:return None
        ok=(len(m.model.layers)==EXPECTED_ARCH[0] and int(m.config.hidden_size)==EXPECTED_ARCH[1] and str(getattr(m.config,"_name_or_path","")).endswith("Qwen2.5-72B-Instruct")
            and any(isinstance(x,bitsandbytes.nn.Linear4bit) for x in m.modules()))
        return (m,t) if ok else None
    except Exception:return None
def stage_model():
    """the model is loaded exactly as in 730.py (tokenizer, PREFIX, NF4 config, from_pretrained arguments, checks, sentinel)"""
    km=_kernel_model() if E.get("model") is None else None
    if km is not None:
        E["model"],E["tok"]=km;m=km[0];cfg=m.config;E["cfg"]=cfg
        E["PIDS"]=E["tok"](E["PREFIX"],add_special_tokens=False).input_ids;E["P"]=len(E["PIDS"])
        E["NL"]=len(m.model.layers);E["H"]=int(cfg.hidden_size);E["QH"]=int(cfg.num_attention_heads);E["KVH"]=int(cfg.num_key_value_heads);E["HD"]=int(getattr(cfg,'head_dim',None) or E["H"]//E["QH"])
        arch=[E["NL"],E["H"],E["QH"],E["KVH"],E["HD"]];E["check"]('ARCH',tuple(arch)==EXPECTED_ARCH,arch)
        for parameter in m.parameters():parameter.requires_grad_(False)
        E["check"]('FROZEN',all(not p.requires_grad for p in m.parameters()))
        E["check"]('DIRECT_FORWARD_NO_EXISTING_HOOKS',not m.model.layers[E["CUT"]]._forward_hooks and not m.model.layers[E["CUT"]]._forward_pre_hooks)
        E["SENTINEL_BEFORE"]=E["sentinel"]();g=E["gpu"]()
        LIVE["model"]=dict(model_id=MODEL_ID,commit=getattr(cfg,"_commit_hash",None),arch=arch,cut=E["CUT"],prefix_tokens=E["P"],sentinel_before=E["SENTINEL_BEFORE"],gpu_after_load=g,utc=utc_now(),
                           reused=True,reused_from="the `model` object already loaded in this Python kernel (e.g. by the TEST730 run) — no second copy")
        LIVE.setdefault("gpu_states",[]).append(dict(state="model weights only (NF4)",**g))
        return f"the Qwen2.5-72B object already in this kernel (TEST730 run) is reused — no second copy on the GPU · GPU allocated {g['allocated_gib']} GiB · sentinel {E['SENTINEL_BEFORE'][:12]}…"
    if E.get("model") is None and torch.cuda.is_available():
        f,_=torch.cuda.mem_get_info()
        if f<48*2**30:
            gc.collect();torch.cuda.empty_cache();f,_=torch.cuda.mem_get_info()
            if f<48*2**30:slog("GPU_NOTE",f"only {f/2**30:.1f} GiB free before loading the 72B model (NF4 needs ≈ 42 GiB + K/V) — another object holds GPU memory; if loading fails: Runtime → Restart session, run the cell again")
    if E.get("model") is not None:
        m=E["model"];arch=[E["NL"],E["H"],E["QH"],E["KVH"],E["HD"]];E["check"]('ARCH',tuple(arch)==EXPECTED_ARCH,arch)
        E["check"]('FROZEN',all(not p.requires_grad for p in m.parameters()))
        E["check"]('DIRECT_FORWARD_NO_EXISTING_HOOKS',not m.model.layers[E["CUT"]]._forward_hooks and not m.model.layers[E["CUT"]]._forward_pre_hooks)
        now=E["sentinel"]()
        if E.get("SENTINEL_BEFORE"):E["check"]('WEIGHTS_SENTINEL_UNCHANGED_SINCE_FIRST_LOAD',now==E["SENTINEL_BEFORE"])
        E["SENTINEL_BEFORE"]=now
        g=E["gpu"]();LIVE["model"]=dict(model_id=MODEL_ID,commit=getattr(E["cfg"],"_commit_hash",None),arch=[E["NL"],E["H"],E["QH"],E["KVH"],E["HD"]],cut=E["CUT"],prefix_tokens=E["P"],
                           sentinel_before=E.get("SENTINEL_BEFORE"),gpu_after_load=g,utc=utc_now(),reused=True)
        LIVE.setdefault("gpu_states",[]).append(dict(state="model weights only (NF4)",**g))
        return "already loaded in this Python kernel by an earlier run of the cell — reused (no second copy on the GPU)"
    t0=time.perf_counter();stop=threading.Event();hb=threading.Thread(target=_heartbeat,args=(stop,t0),daemon=True);hb.start();b0=_hf_cache_bytes()
    try:
        tok=AutoTokenizer.from_pretrained(MODEL_ID,trust_remote_code=False);E["tok"]=tok
        E["PIDS"]=tok(E["PREFIX"],add_special_tokens=False).input_ids;E["P"]=len(E["PIDS"])
        quant=BitsAndBytesConfig(load_in_4bit=True,bnb_4bit_quant_type='nf4',bnb_4bit_compute_dtype=E["DTYPE"],bnb_4bit_use_double_quant=True)
        t1=time.perf_counter()
        model=AutoModelForCausalLM.from_pretrained(MODEL_ID,quantization_config=quant,dtype=E["DTYPE"],device_map={'':0},low_cpu_mem_usage=True,trust_remote_code=False,attn_implementation='sdpa').eval()
        load_s=time.perf_counter()-t1
