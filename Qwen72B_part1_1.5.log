def _engine_check(name,ok,detail=None):
    """the engine's check(): every call is recorded; a failed check raises (as in 730.py) — nothing is shown as passed"""
    row=dict(name=name,passed=bool(ok),detail=jsafe(detail),utc=utc_now(),stage=STATE.get("current"))
    LIVE_CHECKS.append(row);E.setdefault("R",{}).setdefault("checks",[]).append(row);_engine_log("PASS" if ok else "FAIL",name,"" if detail is None else detail)
    if not ok:raise IntegrityError("CHECK_FAILED:"+name)
def _nodes(tree,names,kinds):
    return [n for n in tree.body if isinstance(n,kinds) and getattr(n,"name",None) in names]
def _assign_nodes(tree,names):
    return [n for n in tree.body if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id in names]
def _find_assign(tree,name):
    return next((n for n in ast.walk(tree) if isinstance(n,ast.Assign) and len(n.targets)==1 and isinstance(n.targets[0],ast.Name) and n.targets[0].id==name),None)
def define_engine(raw709,raw730):
    """exec the locked engine functions into E; returns facts about what was executed"""
    t709=ast.parse(raw709.decode("utf-8"));t730=ast.parse(raw730.decode("utf-8"))
    f709=_nodes(t709,NAMES_709,(ast.FunctionDef,))
    if {n.name for n in f709}!=NAMES_709:raise RuntimeError("709.py: locked functions missing: "+str(sorted(NAMES_709-{n.name for n in f709})))
    f730=_nodes(t730,set(NAMES_730_FN),(ast.FunctionDef,ast.ClassDef));c730=_assign_nodes(t730,set(NAMES_730_CONST))
    if {n.name for n in f730}!=set(NAMES_730_FN):raise RuntimeError("730.py: engine functions missing: "+str(sorted(set(NAMES_730_FN)-{n.name for n in f730})))
    if {n.targets[0].id for n in c730}!=set(NAMES_730_CONST):raise RuntimeError("730.py: constants missing")
    E.clear()
    E.update(__name__="p730_engine",torch=torch,types=types,time=time,gc=gc,hashlib=hashlib,json=json,re=re,html=html,urllib=urllib,ET=ET,quote=quote,urlencode=urlencode,
             Path=Path,DynamicCache=DynamicCache,BytesIO=BytesIO,log=_engine_log,save=_engine_save,check=_engine_check,R=dict(test="730-demo",checks=[]))
    exec(compile(ast.fix_missing_locations(ast.Module(body=c730,type_ignores=[])),"730.py","exec"),E)
    exec(compile(ast.fix_missing_locations(ast.Module(body=f709,type_ignores=[])),"709.py","exec"),E)
    exec(compile(ast.fix_missing_locations(ast.Module(body=f730,type_ignores=[])),"730.py","exec"),E)
    pre=_find_assign(t730,"PREFIX");E["PREFIX"]=ast.literal_eval(pre.value)
    if _OLD_E.get("model") is not None:E.update({k:_OLD_E[k] for k in _KEEP if k in _OLD_E});ENGINE_INFO["model_reused_from_previous_cell_run"]=True
    mb=_find_assign(t730,"master_body");ENGINE_INFO["master_body_code"]=compile(ast.Expression(mb.value),"730.py","eval")
    rq=_find_assign(t730,"question");ENGINE_INFO["reading_prompt"]=ast.literal_eval(rq.value)
    sp=_find_assign(t730,"synthesis_prompt");ENGINE_INFO["synthesis_prompt_source"]=ast.get_source_segment(raw730.decode("utf-8"),sp)
    want=dict(CUT=3,CHUNK=128,MAX_NEW=768,GPU_RESERVE_GIB=9.0,EXPECTED=EXPECTED_ARCH,MODEL_ID=MODEL_ID)
    bad={k:E.get(k) for k,v in want.items() if E.get(k)!=v}
