    dump_json(DATA_DIR/"STARTUP_RECORD.json",dict(sources=SOURCES,engine=ENGINE_INFO|{"master_body_code":"(compiled 730.py expression)"},test730_dir=ORIG|{"manifest":bool(ORIG["manifest"]),"results":bool(ORIG["results"])},
