def _xml_attribution(data):
    """authors, journal, DOI and year of an article from its Europe PMC XML (for CC BY attribution)"""
    out={}
    try:
        r=ET.fromstring(data);am=r.find(".//front/article-meta")
        au=[]
        for c in am.findall(".//contrib-group/contrib"):
            if c.get("contrib-type") not in(None,"author"):continue
            n=c.find("name")
            if n is not None:au.append(" ".join(x for x in (n.findtext("given-names"),n.findtext("surname")) if x))
        out["authors"]=au;out["journal"]=E["normalize_text"](" ".join(r.find(".//front/journal-meta//journal-title").itertext())) if r.find(".//front/journal-meta//journal-title") is not None else None
        out["doi"]=next((x.text for x in am.findall("article-id") if x.get("pub-id-type")=="doi"),None)
        out["year"]=next((d.findtext("year") for d in am.findall("pub-date") if d.findtext("year")),None)
    except Exception as ex:out["error"]=f"{type(ex).__name__}: {ex}"
    return out
def stage_sources():
    """the three articles are read again with the unchanged 730.py europe_pmc_fulltext(); the excerpt must equal the record"""
    res={}
    for k in SRC_IDS:
        s=REC["sources"][k];row=dict(id=k,pmcid=s["pmcid"],record_excerpt_sha256=s["excerpt_sha256"],record_full_xml_sha256=s.get("full_html_sha256"))
        try:
            t=time.perf_counter();p=E["europe_pmc_fulltext"](s["pmcid"],dict(id=k,url=s["url"]))
            data,_,_=E["http_get"]("https://www.ebi.ac.uk/europepmc/webservices/rest/"+quote(s["pmcid"],safe="")+"/fullTextXML",6_000_000)
            row.update(seconds=round(time.perf_counter()-t,2),excerpt_sha256_now=p["excerpt_sha256"],excerpt_equal=(p["excerpt_sha256"]==s["excerpt_sha256"]),
                       excerpt_chars=p["excerpt_chars"],title_now=p["title"],title_equal=(p["title"]==s["title"]),license_now=p["license"],
                       full_xml_sha256_now=p["full_html_sha256"],full_xml_equal=(p["full_html_sha256"]==s.get("full_html_sha256")),attribution=_xml_attribution(data),utc=utc_now())
            row["body"]=p["body"] if row["excerpt_equal"] else None
        except Exception as ex:row.update(error=f"{type(ex).__name__}: {ex}",excerpt_equal=False,body=None)
        res[k]=row;slog("SOURCE_REVERIFY",k,excerpt_equal=row.get("excerpt_equal"),full_xml_equal=row.get("full_xml_equal"),error=row.get("error"))
    LIVE["sources"]={k:{x:y for x,y in v.items() if x!="body"} for k,v in res.items()};LIVE["_source_bodies"]={k:v.get("body") for k,v in res.items()}
    ok=sum(1 for v in res.values() if v.get("excerpt_equal"))
    return f"{ok}/3 excerpts re-derived byte-identical to the TEST730 record"+("" if ok==3 else " — see REAL SOURCES (an upstream change or a network error is reported, not hidden)")

def stage_gpu():
    rep=dict(cuda=bool(torch.cuda.is_available()))
    if rep["cuda"]:
        rep.update(count=torch.cuda.device_count(),name=torch.cuda.get_device_name(0),total_gib=round(gib(torch.cuda.get_device_properties(0).total_memory),2))
    rep.update(torch=str(torch.__version__),cuda_version=str(getattr(torch.version,"cuda",None)) if hasattr(torch,"version") else None,transformers=str(transformers.__version__),
               bitsandbytes=(getattr(bitsandbytes,"__version__",None) if bitsandbytes else None),bnb_error=_BNB_ERR,python=platform.python_version())
    try:
