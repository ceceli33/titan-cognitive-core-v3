def build_master_body(reflections,conclusion):
    """the exact 730.py expression that composed the MASTER body (evaluated, not retyped)"""
    return eval(ENGINE_INFO["master_body_code"],{"__builtins__":{}},{"reflections":reflections,"conclusion":conclusion})

