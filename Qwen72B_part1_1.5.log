def _walk_find(base,fname,depth,limit=4000):
    out=[];seen=0;base=Path(base);d0=len(base.parts)
    for root,dirs,files in os.walk(base):
        seen+=1
        if seen>limit:break
        if len(Path(root).parts)-d0>=depth:dirs[:]=[]
        dirs[:]=[d for d in dirs if not d.startswith(".") and d not in("sample_data","AKBASCORE_TEST730_DEMO","sessions")]
        if fname in files:out.append(Path(root))
    return out
def locate_test730_root():
    cands=[_CROOT/"AKBASCORE_TEST730",Path("/content/AKBASCORE_TEST730"),Path("/tmp/AKBASCORE_TEST730")]
    for base,depth in ((_CROOT,2),(Path("/content/drive/MyDrive"),4),(Path("/content/drive/My Drive"),4)):
        if base.is_dir():
            try:cands+=_walk_find(base,"TEST730_manifest.json",depth)+[p.parent for p in _walk_find(base,"MASTER.pt",depth+1) if p.name=="physical_cartridges"]
            except Exception:pass
    for c in OrderedDict((str(x),x) for x in cands).values():
        if (c/"physical_cartridges").is_dir() and any((c/"physical_cartridges"/f"{k}.pt").is_file() for k in CARTS):return c
    return None
def _entry_from_json(e):
    """JSON cannot hold tuples: the tensor seals of a manifest entry are restored to the exact form seal_cp() returns
    ({'h':sha,'lower':[(k_sha,v_sha),...]}) so that the unchanged safe_load() compares like with like"""
    if not e:return e
    e=dict(e);ts=e.get("tensor_sha")
    if isinstance(ts,dict):e["tensor_sha"]={"h":ts.get("h"),"lower":[tuple(x) for x in (ts.get("lower") or [])]}
    return e
def read_test730_directory():
    """finds the TEST730 directory, verifies every file against the record and returns the per-cartridge status (CPU only)"""
    root=locate_test730_root();ORIG.update(root=str(root) if root else None,manifest=None,results=None,sealed_sources={},notes=[])
    man=jload(root/"TEST730_manifest.json") if root else None;res=jload(root/"TEST730_results.json") if root else None
    ORIG["manifest"]=man;ORIG["results"]=res
    if man:
        ORIG["manifest_checks"]=dict(question_sha=(man.get("question_sha256")==REC["panel_sha256"]),
            engine_locks=(man.get("engine")=={"709":LOCKS["709.py"],"716":LOCKS["716.py"]}),
            commits_equal_log={e["id"]:e.get("sha256")==REC["commits"].get(e["id"],{}).get("sha256") for e in man.get("cartridges",[])})
    if res:
        qs={q["id"]:q for q in res.get("questions",[])}
        ORIG["results_checks"]=dict(answers_equal_log={i:(qs.get(i,{}).get("answer_sha256")==q["answer_sha256_log_text"]) for i,q in REC["questions"].items()},
            synthesis_equal_log=((res.get("model_synthesis") or {}).get("sha256")==REC["synthesis_sha256_log_text"]),status=res.get("status"),
            baseline_available=bool(res.get("no_memory_baseline")))
    for k in SRC_IDS:
        p=root/"sealed_sources"/f"{k}.txt" if root else None
        if p and p.is_file():
            s=sha_file(p);ORIG["sealed_sources"][k]=dict(path=str(p),sha256=s,equal_record=(s==REC["sources"][k]["excerpt_sha256"]))
    for cid in CARTS:
        rec_sha=REC["commits"][cid]["sha256"];a=dict(id=cid,sha256_record=rec_sha,body_tokens_record=REC["body_tokens"].get(cid),role=REC["commits"][cid]["role"])
        mentry=next((e for e in (man or {}).get("cartridges",[]) if e.get("id")==cid),None)
        p=(root/"physical_cartridges"/f"{cid}.pt") if root else None
        if p and p.is_file():
            t=time.perf_counter();s=sha_file(p);a.update(path=str(p),bytes=p.stat().st_size,sha256_now=s,sha_seconds=round(time.perf_counter()-t,3),equal_record=(s==rec_sha),
                        status="ORIGINAL_VERIFIED" if s==rec_sha else "ORIGINAL_SHA_MISMATCH",origin="TEST730 run directory of this runtime",
                        entry=(_entry_from_json(mentry) if (mentry and mentry.get("sha256")==rec_sha) else None),tensor_record=bool(mentry and mentry.get("tensor_sha")))
        else:a.update(status="MISSING",origin="not present in this runtime",equal_record=False,entry=None,tensor_record=False)
        ART[cid]=a
    slog("TEST730_FILES",f"root={root}",**{k:v["status"] for k,v in ART.items()});return ART

