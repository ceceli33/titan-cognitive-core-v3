    E["NL"]=len(model.model.layers);E["H"]=int(cfg.hidden_size);E["QH"]=int(cfg.num_attention_heads);E["KVH"]=int(cfg.num_key_value_heads);E["HD"]=int(getattr(cfg,'head_dim',None) or E["H"]//E["QH"])
    arch=[E["NL"],E["H"],E["QH"],E["KVH"],E["HD"]]
    E["check"]('ARCH',tuple(arch)==EXPECTED_ARCH,arch);E["check"]('FROZEN',all(not p.requires_grad for p in model.parameters()))
    E["check"]('NF4',any(isinstance(m,bitsandbytes.nn.Linear4bit) for m in model.modules()))
    E["check"]('DIRECT_FORWARD_NO_EXISTING_HOOKS',not model.model.layers[E["CUT"]]._forward_hooks and not model.model.layers[E["CUT"]]._forward_pre_hooks)
    t2=time.perf_counter();before=E["sentinel"]();sen_s=time.perf_counter()-t2;E["SENTINEL_BEFORE"]=before
    g=E["gpu"]()
    LIVE["model"]=dict(model_id=MODEL_ID,commit=getattr(cfg,"_commit_hash",None),arch=arch,cut=E["CUT"],prefix_tokens=E["P"],total_seconds=round(time.perf_counter()-t0,1),
                       from_pretrained_seconds=round(load_s,1),hf_cache_gb_before=(round(b0/1e9,1) if b0 is not None else None),hf_cache_gb_after=(round((_hf_cache_bytes() or 0)/1e9,1)),
                       sentinel_before=before,sentinel_seconds=round(sen_s,2),gpu_after_load=g,utc=utc_now(),reused=False)
    LIVE.setdefault("gpu_states",[]).append(dict(state="model weights only (NF4)",**g))
    slog("MEASURED_MODEL","Qwen2.5-72B-Instruct loaded on the GPU",**{k:v for k,v in LIVE["model"].items()})
    return f"loaded in {LIVE['model']['total_seconds']/60:.1f} min · {arch[0]} layers · prefix {E['P']} tokens · GPU allocated {g['allocated_gib']} GiB · sentinel {before[:12]}…"

def _tensor_facts(cp):
    h=cp["h"];low=cp["lower"]
    nb=lambda t:int(t.numel())*int(t.element_size())
    return dict(n=int(cp["n"]),p=int(cp["p"]),body_tokens=int(cp["body_tokens"]),book_id=cp["book_id"],h_shape=list(h.shape),h_dtype=str(h.dtype),h_bytes=nb(h),
                lower_layers=len(low),k_shape=list(low[0][0].shape),v_shape=list(low[0][1].shape),lower_bytes=sum(nb(k)+nb(v) for k,v in low),
                full_80_layer_kv_bytes=int(cp["n"])*E["NL"]*E["KVH"]*E["HD"]*2*2 if E.get("NL") else int(cp["n"])*80*8*128*2*2)
def _h3_norms(cp):
    try:return cp["h"][0].float().norm(dim=-1).numpy().astype(np.float32)
    except Exception:return None
def _load_verified(cid):
    """SSD → CPU with verification: the unchanged 730.py safe_load() when the TEST730 tensor record exists, otherwise the same
    three checks with the tensor seal computed (and reported) because no TEST730 tensor record is available in this runtime"""
    a=ART[cid];E["CART_DIR"]=Path(a["path"]).parent
    if a.get("entry") and a["entry"].get("tensor_sha"):
        cp=E["safe_load"](a["entry"]);a["tensor_check"]="730.py safe_load(): FILE_SHA + CARTRIDGE_ID + CARTRIDGE_TENSOR_SHA against the TEST730 manifest"
    else:
        path=Path(a["path"]);E["check"]('FILE_SHA_'+cid,path.exists() and sha_file(path)==a["sha256_expected"])
        cp=torch.load(path,map_location='cpu',weights_only=True)
        E["check"]('CARTRIDGE_ID_'+cid,cp['book_id']==cid and cp['p']==E["P"] and cp['n']==E["P"]+cp['body_tokens'])
        seal=E["seal_cp"](cp);a["tensor_seal_now"]=seal["h"];a["tensor_check"]="FILE_SHA + CARTRIDGE_ID checked; tensor seal computed now (no TEST730 tensor record in this runtime)"
    return cp

def _is_oom_err(ex):return "OutOfMemoryError" in type(ex).__name__ or "out of memory" in str(ex).lower() or "GPU_SAFETY_STOP" in str(ex)
def _recover_cartridges(missing):
    """ONLY for cartridges absent from this runtime: the unchanged 730.py commit() forges them again from their SHA-verified
    sealed texts into a SEPARATE folder. No text is generated: source texts = Europe PMC excerpt (SHA = record), MASTER body =
    the exact 730.py expression over the reflections and the synthesis recorded in 730.log."""
    RECOVERY_DIR.mkdir(parents=True,exist_ok=True);rman=RECOVERY_DIR/"RECOVERY_manifest.json";prev=jload(rman,{}) or {}
    E["CART_DIR"]=RECOVERY_DIR;E["MANIFEST"]=rman;E["entries"]={}
    E["ledger"]=dict(test="730-demo-recovery",note="re-forged with the unchanged 730.py commit() because the TEST730 files are not present in this runtime",
                     engine={"709":LOCKS["709.py"],"730":LOCKS["730.py"]},cartridges=list(prev.get("cartridges",[])),session=SESSION_ID)
    out={};errs={}
    for cid in missing:
      try:
        old=next((e for e in E["ledger"]["cartridges"] if e.get("id")==cid),None)
        if old and (RECOVERY_DIR/old["file"]).is_file() and sha_file(RECOVERY_DIR/old["file"])==old["sha256"]:
            out[cid]=dict(_entry_from_json(old),reused_from_earlier_session=True);continue
        _emit(f"  forging {cid} with the unchanged 730.py commit() (native CUT3 forge → torch.save → SHA-256) …")
        if cid=="MASTER":
            refl=[dict(id=k,reflection=REC["reflections"][k]) for k in SRC_IDS];body=build_master_body(refl,REC["synthesis"])
            how="MASTER body = 730.py master_body expression over the three reflections and the synthesis recorded in 730.log (no regeneration)"
        else:
            body=(LIVE.get("_source_bodies") or {}).get(cid)
            sp=ORIG["sealed_sources"].get(cid)
            if body is None and sp and sp["equal_record"]:body=Path(sp["path"]).read_text(encoding="utf-8")
            if body is None:raise IntegrityError(f"{cid}: no SHA-verified source text available (Europe PMC excerpt changed or unreachable) — the cartridge cannot be re-forged faithfully")
            how="source text = Europe PMC full-text excerpt re-derived with 730.py europe_pmc_fulltext(), SHA-256 equal to the TEST730 record"
            E["check"]("RECOVERY_SOURCE_TEXT_SHA_"+cid,sha_text(body)==REC["sources"][cid]["excerpt_sha256"])
        ntok=len(E["tok"](body,add_special_tokens=False).input_ids)
        E["check"]("RECOVERY_BODY_TOKENS_EQUAL_RECORD_"+cid,ntok==REC["body_tokens"][cid],{"tokens":ntok,"record":REC["body_tokens"][cid]})
        e=E["commit"](cid,body,REC["commits"][cid]["role"],(["P01","P02","P03"] if cid=="MASTER" else []))
        e=dict(e,how=how,session=SESSION_ID,utc=utc_now());out[cid]=e
        E["ledger"]["cartridges"]=[x for x in E["ledger"]["cartridges"] if x.get("id")!=cid]+[e];E["atomic_json"](rman,E["ledger"])
        _emit(f"  {cid} forged · {e['body_tokens']} body tokens · {e.get('forge_seconds')} s · file SHA-256 {e['sha256'][:16]}… · equal to TEST730 record: {e['sha256']==REC['commits'][cid]['sha256']}")
      except Exception as ex:
        errs[cid]=f"{type(ex).__name__}: {ex}";slog("CARTRIDGE_NOT_FORGED",cid,error=errs[cid])
        if _is_oom_err(ex):E["release"]()
    LIVE["forge_errors"]=errs
    return out
def stage_cartridges():
    read_test730_directory()
    for cid in CARTS:ART[cid]["sha256_expected"]=ART[cid]["sha256_record"]
    missing=[c for c in CARTS if ART[c]["status"]!="ORIGINAL_VERIFIED"]
    if missing and STATE["mode"]=="LIVE" and E.get("model") is not None:
        rec=_recover_cartridges(missing)
        for cid,e in rec.items():
            p=RECOVERY_DIR/e["file"];same=(e["sha256"]==ART[cid]["sha256_record"])
            ART[cid].update(path=str(p),bytes=p.stat().st_size,sha256_now=e["sha256"],equal_record=same,entry=e,tensor_record=True,sha256_expected=e["sha256"],
                            status=("RECOVERED_BIT_IDENTICAL" if same else "RECOVERED_DIFFERENT_FILE"),forge_seconds=e.get("forge_seconds"),
                            origin=("re-forged earlier in this runtime" if e.get("reused_from_earlier_session") else "re-forged in this session")+" from SHA-verified sealed text with unchanged 730.py commit()",how=e.get("how"))
            slog("CARTRIDGE_RECOVERED",cid,file_sha_equal_test730_record=same,sha=e["sha256"][:16])
    for cid in CARTS:
        a=ART[cid]
        if not a.get("path"):continue
        t=time.perf_counter()
        try:cp=torch.load(a["path"],map_location="cpu",weights_only=True)
        except Exception as ex:a["load_error"]=f"{type(ex).__name__}: {ex}";continue
        a["facts"]=_tensor_facts(cp);a["load_cpu_seconds"]=round(time.perf_counter()-t,3)
        slog("MEASURED_CARTRIDGE",cid,status=a["status"],file=a["path"],bytes=a.get("bytes"),sha256_now=a.get("sha256_now"),sha256_test730_record=a["sha256_record"],
             equal_to_record=a.get("equal_record"),**a["facts"])
        hn=_h3_norms(cp)
        if hn is not None:np.save(XRAY_DIR/f"H3_NORMS_{cid}.npy",hn);a["h3_norm_file"]=str(XRAY_DIR/f"H3_NORMS_{cid}.npy")
        low=cp["lower"];a["lower_norms"]=[dict(layer=i,k_mean=float(k[0].float().norm(dim=-1).mean().item()),v_mean=float(v[0].float().norm(dim=-1).mean().item())) for i,(k,v) in enumerate(low)]
        del cp,low;gc.collect()
    LIVE["cartridges"]={k:{x:y for x,y in v.items() if x not in("entry",)} for k,v in ART.items()}
    usable=[c for c in CARTS if ART[c]["status"] in("ORIGINAL_VERIFIED","RECOVERED_BIT_IDENTICAL","RECOVERED_DIFFERENT_FILE")]
    LIVE["usable_cartridges"]=usable
    if "MASTER" not in usable:
        why=("the model is not loaded (no A100 / REPLAY MODE), so missing cartridges cannot be forged" if E.get("model") is None else
             "forging failed: "+"; ".join(f"{k}: {v}" for k,v in (LIVE.get("forge_errors") or {}).items()))
        raise IntegrityError("no usable MASTER cartridge — "+why+" · status: "+", ".join(f"{c} {ART[c]['status']}" for c in CARTS))
    fe=LIVE.get("forge_errors") or {}
    return " · ".join(f"{c}: {ART[c]['status'].replace('_',' ').lower()}" for c in CARTS)+("" if not fe else " · NOT FORGED: "+"; ".join(f"{k} — {v}" for k,v in fe.items()))

def _memory_bytes(mem):return sum(int(k.numel())*int(k.element_size())+int(v.numel())*int(v.element_size()) for k,v in mem)
def stage_master():
    if "MASTER" not in LIVE.get("usable_cartridges",[]):raise IntegrityError("MASTER cartridge not available — no live MASTER operation is possible (nothing is substituted)")
    a=ART["MASTER"];t_read=time.perf_counter();raw=Path(a["path"]).read_bytes();t_read=time.perf_counter()-t_read;del raw
    t0=time.perf_counter();cpu=_load_verified("MASTER");t_safe=time.perf_counter()-t0
    t1=time.perf_counter();gcp=E["to_gpu"](cpu);E["sync"]();t_h2d=time.perf_counter()-t1;del cpu
    t2=time.perf_counter();memory=E["initialize_native"](gcp);E["sync"]();t_init=time.perf_counter()-t2
    t3=time.perf_counter();seals=E["memory_seals"](memory);t_seal=time.perf_counter()-t3
    STATE["master_memory"]=memory;STATE["master_gpu_cp"]=gcp;STATE["master_seals_before"]=seals
    g=E["gpu"]();rows=int(memory[0][0].shape[-2])
    LIVE["master_fast_path"]=dict(file_bytes=a["bytes"],ssd_read_seconds=round(t_read,3),ssd_read_mb_s=round(a["bytes"]/1e6/max(t_read,1e-9),1),
        verified_load_seconds=round(t_safe,3),verification=a.get("tensor_check"),h2d_seconds=round(t_h2d,3),initialize_native_seconds=round(t_init,3),
        prefix_seal_seconds=round(t_seal,3),total_seconds=round(time.perf_counter()-t0,3),layers=len(memory),rows=rows,memory_bytes=_memory_bytes(memory),
        recorded_init_seconds=(REC.get("fast_path") or {}).get("init_seconds"),gpu=g,cartridge_status=a["status"],utc=utc_now())
    slog("MEASURED_MASTER_FAST_PATH","MASTER mounted alone (80 layers)",**{k:v for k,v in LIVE["master_fast_path"].items()})
    LIVE.setdefault("gpu_states",[]).append(dict(state="MASTER only (state B)",memory_bytes=_memory_bytes(memory),**g))
    return f"{len(memory)} layers · {rows} rows · verified load {t_safe:.2f} s · H2D {t_h2d:.2f} s · initialize {t_init:.2f} s (record: {(REC.get('fast_path') or {}).get('init_seconds')} s incl. load)"

def stage_parity():
    gcp=STATE.get("master_gpu_cp")
    if gcp is None or STATE.get("master_memory") is None:raise IntegrityError("MASTER is not mounted")
    t=time.perf_counter();ref=E["initialize"](gcp);ref_seals=E["memory_seals"](ref);del ref;E["release"]()
    nat=STATE["master_seals_before"];m=sum(a==b for a,b in zip(ref_seals,nat))
    E["check"]('MASTER_80_LAYER_PARITY',E["compare_seals"](ref_seals,nat),{'matched':m,'layers':E["NL"]})
    slog("MEASURED_PARITY",f"{m}/{E['NL']} layers exact SHA-256",matched=m,layers=E["NL"],seconds=round(time.perf_counter()-t,2))
    LIVE["parity"]=dict(matched=m,layers=E["NL"],seconds=round(time.perf_counter()-t,2),reference="709.py initialize() (forward hook) vs 730.py initialize_native() (direct forward) — the mounted fast-path memory",
                        recorded=next((c["detail"] for c in REC["checks"] if c["name"]=="MASTER_80_LAYER_PARITY"),None),utc=utc_now())
    STATE["master_gpu_cp"]=None;del gcp;E["release"]()
    return f"{m}/{E['NL']} layers exact SHA-256 (record: 80/80)"

XRAY_BIN=32
def _xray(memory):
    """read-only: per token, L2 norm over head_dim, mean over the 8 KV heads; K and V for all layers"""
    K=[];V=[]
    with torch.no_grad():
        for k,v in memory:
            K.append(k[0].float().norm(dim=-1).mean(dim=0).cpu().numpy());V.append(v[0].float().norm(dim=-1).mean(dim=0).cpu().numpy())
    return np.stack(K).astype(np.float32),np.stack(V).astype(np.float32)
def _xray_store(cid,memory,seconds,mounted_note):
    K,V=_xray(memory);np.savez_compressed(XRAY_DIR/f"XRAY_{cid}.npz",K=K,V=V)
    P=int(E["P"]);body=slice(P,None)
    meta=dict(cid=cid,rows=int(K.shape[1]),layers=int(K.shape[0]),prefix_tokens=P,file=str(XRAY_DIR/f"XRAY_{cid}.npz"),seconds=round(seconds,2),mounted=mounted_note,
              k_layer_mean_body=K[:,body].mean(axis=1).tolist(),v_layer_mean_body=V[:,body].mean(axis=1).tolist(),
              k_layer_p05_body=np.percentile(K[:,body],5,axis=1).tolist(),k_layer_p95_body=np.percentile(K[:,body],95,axis=1).tolist(),
              v_layer_p05_body=np.percentile(V[:,body],5,axis=1).tolist(),v_layer_p95_body=np.percentile(V[:,body],95,axis=1).tolist(),
              provenance=("SIMULATION" if SIM else "GPU_REAL"),method="‖K‖,‖V‖ = L2 over head_dim (128), mean over 8 KV heads, per memory row; read-only",utc=utc_now())
    LIVE.setdefault("xray",{})[cid]=meta
    slog("MEASURED_XRAY",cid,rows=meta["rows"],layers=meta["layers"],seconds=meta["seconds"],mounted=mounted_note,file=meta["file"],
         k_mean_L0_3=float(np.mean(meta["k_layer_mean_body"][:4])),k_mean_L4_79=float(np.mean(meta["k_layer_mean_body"][4:])),
         v_mean_L0_3=float(np.mean(meta["v_layer_mean_body"][:4])),v_mean_L4_79=float(np.mean(meta["v_layer_mean_body"][4:])))
    return meta
def stage_xray():
    done=[]
    if STATE.get("master_memory") is not None:
        t=time.perf_counter();_xray_store("MASTER",STATE["master_memory"],time.perf_counter()-t,"MASTER fast-path memory (state B)");done.append("MASTER")
    for cid in SRC_IDS:
        if cid not in LIVE.get("usable_cartridges",[]):continue
        t=time.perf_counter();cpu=_load_verified(cid);gcp=E["to_gpu"](cpu);del cpu;mem=E["initialize_native"](gcp);del gcp
        g=E["gpu"]();LIVE.setdefault("gpu_states",[]).append(dict(state=f"{cid} alone + MASTER (X-ray)",memory_bytes=_memory_bytes(mem),**g))
        _xray_store(cid,mem,time.perf_counter()-t,f"{cid} mounted ALONE (separate initialize_native; not simultaneous with the other sources)");del mem;E["release"]();done.append(cid)
    dump_json(DATA_DIR/"XRAY_SUMMARY.json",LIVE.get("xray"))
    return f"measured: {', '.join(done)} · 80 layers each · each source mounted alone"

def answer_measured(memory,question,origin):
    """the unchanged engine answer(); a read-only counter on lm_head (returns None) counts forward passes → generated tokens"""
    calls=[0];h=E["model"].lm_head.register_forward_hook(lambda m,a,o:calls.__setitem__(0,calls[0]+1))
    g0=E["gpu"]();t=time.perf_counter()
    try:txt=E["answer"](memory,question)
    finally:h.remove()
    E["sync"]();s=time.perf_counter()-t;n=max(calls[0]-1,0)
    rows=0 if memory is None else int(memory[0][0].shape[-2])
    slog("MEASURED_ANSWER",origin,memory=("MASTER" if memory is not None else "NONE"),memory_rows=rows,n_generated=n,seconds=round(s,3),tokens_per_second=(round(n/s,2) if s>0 else None),
         ceiling_reached=(n>=E["MAX_NEW"]),sha256=sha_text(txt),answer=txt[:4000])
    return dict(question=question,answer=txt,sha256=sha_text(txt),seconds=round(s,3),n_generated=n,max_new=E["MAX_NEW"],ceiling_reached=(n>=E["MAX_NEW"]),
                tokens_per_second=round(n/s,2) if s>0 else None,memory=("MASTER" if memory is not None else "NONE"),memory_rows=rows,origin=origin,
                gpu_free_gib=g0.get("free_gib"),utc=utc_now(),provenance=("SIMULATION" if SIM else "GPU_REAL"))
def stage_repro():
    mem=STATE.get("master_memory")
    if mem is None:raise IntegrityError("MASTER is not mounted")
    out={}
    for qid in REPRO_IDS:
        q=REC["questions"][qid];r=answer_measured(mem,q["question"],"reproduction of sealed "+qid)
        r.update(id=qid,recorded_sha256=q["answer_sha256_log_text"],recorded_seconds=q["seconds"],identical_to_record=(r["answer"]==q["answer"]),
                 common_prefix_chars=len(os.path.commonprefix([r["answer"],q["answer"]])))
        out[qid]=r;slog("REPRODUCTION",qid,identical=r["identical_to_record"],seconds=r["seconds"],n=r["n_generated"]);bump()
        LIVE["repro"]=out
    LIVE["repro"]=out
    return " · ".join(f"{k}: {'byte-identical to the record' if v['identical_to_record'] else 'differs from the record after %d chars'%v['common_prefix_chars']} ({v['seconds']:.0f} s)" for k,v in out.items())
def _markers(text,ms):return {m:(m.lower() in str(text).lower()) for m in ms}
def stage_newq():
    mem=STATE.get("master_memory")
    if mem is None:raise IntegrityError("MASTER is not mounted")
    out={}
    for q in NEW_QUESTIONS:
        r=answer_measured(mem,q["question"],"new demo question "+q["id"]);c=answer_measured(None,q["question"],"new demo question "+q["id"]+" without memory")
        r["markers"]=_markers(r["answer"],q["markers"]);c["markers"]=_markers(c["answer"],q["markers"])
        out[q["id"]]=dict(id=q["id"],question=q["question"],markers=q["markers"],master=r,no_memory=c,sealed_panel=False);LIVE["newq"]=out;bump()
        slog("NEW_QUESTION",q["id"],master_markers=sum(r["markers"].values()),no_memory_markers=sum(c["markers"].values()))
    return " · ".join(f"{k}: markers MASTER {sum(v['master']['markers'].values())}/{len(v['markers'])} vs no memory {sum(v['no_memory']['markers'].values())}/{len(v['markers'])}" for k,v in out.items())
def stage_integrity():
    res={}
    mem=STATE.get("master_memory")
    if mem is not None:
        same=E["compare_seals"](STATE["master_seals_before"],E["memory_seals"](mem));E["check"]('FAST_PATH_MASTER_PREFIX_UNCHANGED',same);res["master_prefix_unchanged"]=same
    if E.get("SENTINEL_BEFORE"):
        after=E["sentinel"]();E["check"]('WEIGHTS_SENTINEL_UNCHANGED',after==E["SENTINEL_BEFORE"]);res.update(sentinel_before=E["SENTINEL_BEFORE"],sentinel_after=after)
        res["trainable_tensors"]=sum(1 for p in E["model"].parameters() if p.requires_grad)
    files={}
    for cid in CARTS:
        a=ART.get(cid) or {}
        if a.get("path") and Path(a["path"]).is_file():files[cid]=dict(sha256=sha_file(a["path"]),expected=a.get("sha256_expected"),unchanged=(sha_file(a["path"])==a.get("sha256_expected")))
    res["cartridge_files"]=files;res["all_files_unchanged"]=all(v["unchanged"] for v in files.values()) if files else None
    E["check"]("ALL_PHYSICAL_CARTRIDGES_PRESERVED",bool(files) and res["all_files_unchanged"],{k:v["unchanged"] for k,v in files.items()})
    res["utc"]=utc_now();LIVE["integrity"]=res;slog("MEASURED_INTEGRITY","after use",**res)
    return f"prefix unchanged {res.get('master_prefix_unchanged')} · weights unchanged {res.get('sentinel_after')==res.get('sentinel_before') if res.get('sentinel_before') else '—'} · files unchanged {res['all_files_unchanged']}"

def live_query(question):
    """LIVE QUERY MODE: a new question to the mounted MASTER (never part of the sealed panel)"""
    mem=STATE.get("master_memory")
    if mem is None:raise IntegrityError("The MASTER memory is not mounted in this session (press RUN on an A100 runtime first). No recorded answer is shown instead.")
    r=answer_measured(mem,question,"user (LIVE QUERY tab)");r["sealed_panel"]=False;r["session"]=SESSION_ID
    with LIVE_QA.open("a",encoding="utf-8") as f:f.write(json.dumps(jsafe(r),ensure_ascii=False)+"\n")
    LIVE.setdefault("user_queries",[]).append(r);bump();return r
